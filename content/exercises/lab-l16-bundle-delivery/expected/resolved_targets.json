{
  "dev": {
    "mode": "development",
    "default": true,
    "host": "https://cinderline-dev.example",
    "root_path": "~/.bundle/cinderline_scrap/dev",
    "variables": {
      "catalog": "cinderline_dev",
      "schema": "quality_${workspace.current_user.short_name}",
      "alert_threshold": "0.0400"
    },
    "task_parameters": {
      "scrap_summary.summarize": [
        "--catalog",
        "cinderline_dev",
        "--schema",
        "quality_${workspace.current_user.short_name}",
        "--alert-threshold",
        "0.0400"
      ]
    },
    "run_as": null,
    "git_branch": null,
    "schedule": "paused by mode: development",
    "needs_workspace": [
      "root_path",
      "variables.schema"
    ]
  },
  "test": {
    "mode": "production",
    "default": false,
    "host": "https://cinderline-test.example",
    "root_path": "/Workspace/Users/00000000-0000-0000-0000-00000000a001/.bundle/cinderline_scrap/test",
    "variables": {
      "catalog": "cinderline_test",
      "schema": "quality",
      "alert_threshold": "0.0400"
    },
    "task_parameters": {
      "scrap_summary.summarize": [
        "--catalog",
        "cinderline_test",
        "--schema",
        "quality",
        "--alert-threshold",
        "0.0400"
      ]
    },
    "run_as": "00000000-0000-0000-0000-00000000a001",
    "git_branch": null,
    "schedule": "paused by presets.trigger_pause_status",
    "needs_workspace": []
  },
  "prod": {
    "mode": "production",
    "default": false,
    "host": "https://cinderline-prod.example",
    "root_path": "/Workspace/Users/00000000-0000-0000-0000-00000000b001/.bundle/cinderline_scrap/prod",
    "variables": {
      "catalog": "cinderline_prod",
      "schema": "quality",
      "alert_threshold": "0.0400"
    },
    "task_parameters": {
      "scrap_summary.summarize": [
        "--catalog",
        "cinderline_prod",
        "--schema",
        "quality",
        "--alert-threshold",
        "0.0400"
      ]
    },
    "run_as": "00000000-0000-0000-0000-00000000b001",
    "git_branch": "main",
    "schedule": "as written in the job",
    "needs_workspace": []
  }
}
