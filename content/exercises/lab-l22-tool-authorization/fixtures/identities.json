        "drafts:write:north",
        "parts:request:north"
      ]
    },
    "tech-s1": {
      "role": "South plant technician",
      "plant": "south",
      "grants": [
        "manuals:read:south",
        "drafts:write:south",
        "parts:request:south"
      ]
    },
    "sup-n1": {
      "role": "North plant maintenance supervisor",
      "plant": "north",
      "grants": [
        "manuals:read:north",
        "drafts:write:north",
        "drafts:close:north",
        "parts:request:north",
        "parts:approve:north"
      ]
    }
