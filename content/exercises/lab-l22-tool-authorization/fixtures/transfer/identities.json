{
  "application": {
    "id": "app-supply-assistant",
    "kind": "service principal",
    "delegated_scopes": [
      "catalog:read",
      "supplies:order",
      "orders:cancel"
    ],
    "note": "The clinic's assistant may order and cancel on a user's behalf."
  },
  "users": {
    "nurse-e1": {
      "role": "East site ward nurse",
      "site": "east",
      "grants": [
        "catalog:read:east",
        "supplies:order:east"
      ]
    },
    "nurse-w1": {
      "role": "West site ward nurse",
      "site": "west",
      "grants": [
        "catalog:read:west",
        "supplies:order:west"
      ]
    },
    "pharm-e1": {
      "role": "East site pharmacist",
      "site": "east",
      "grants": [
        "catalog:read:east",
        "supplies:order:east",
        "supplies:approve:east",
        "orders:cancel:east"
      ]
    }
  },
  "sessions": {
    "s-nurse-e1": {
      "user": "nurse-e1",
      "valid": true
    },
    "s-nurse-w1": {
      "user": "nurse-w1",
      "valid": true
    },
    "s-pharm-e1": {
      "user": "pharm-e1",
      "valid": true
    }
  }
}
