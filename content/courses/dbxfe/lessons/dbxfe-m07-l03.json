        "dbxfe-fiction",
        "dbxfe-fact-evaluation"
      ]
    },
    {
      "id": "dbxfe-m07-l03-card2",
      "revision": "1",
      "prompt": "When can abstention be the correct result?",
      "answer": "When evidence or authority is insufficient for the requested answer or action.",
      "explanation": "A fluent unsupported answer can be less useful and more risky.",
      "lessonId": "dbxfe-m07-l03",
      "sectionId": "dbxfe-m07-l03-understand",
      "conceptIds": [
