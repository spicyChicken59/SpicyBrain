  "questions": [
    {
      "id": "dbxfe-m07-l03-q1",
      "revision": "1",
      "prompt": "An assistant’s average helpfulness is high, but it exposes an unauthorized document. What follows in this proposed plan?",
      "options": [
        {
          "id": "dbxfe-m07-l03-q1-c",
          "text": "Treat the source citation as permission.",
          "rationale": "Citation does not establish the user’s authorization."
        },
        {
          "id": "dbxfe-m07-l03-q1-a",
          "text": "Block expansion and investigate the access failure.",
          "rationale": "A material permission violation is not offset by good average answers."
        },
        {
          "id": "dbxfe-m07-l03-q1-b",
          "text": "Average the incident away.",
          "rationale": "Aggregates can conceal unacceptable boundary failures."
        }
      ],
      "correctOptionId": "dbxfe-m07-l03-q1-a",
      "conceptIds": [
        "dbxfe-m07-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-evaluation"
      ]
    },
    {
      "id": "dbxfe-m07-l03-q2",
      "revision": "1",
      "prompt": "How should model-based judging be used?",
      "options": [
        {
          "id": "dbxfe-m07-l03-q2-a",
          "text": "As fallible evidence calibrated against human-reviewed examples.",
          "rationale": "Judge scores need validation and disagreement analysis."
        },
        {
          "id": "dbxfe-m07-l03-q2-b",
          "text": "As an automatic safety certificate.",
          "rationale": "A scorer cannot establish every real-world behavior."
        },
        {
          "id": "dbxfe-m07-l03-q2-c",
          "text": "Only after removing all difficult cases.",
          "rationale": "That would weaken evaluation coverage."
        }
      ],
      "correctOptionId": "dbxfe-m07-l03-q2-a",
      "conceptIds": [
        "dbxfe-m07-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-evaluation"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m07-l03-card1",
      "revision": "1",
      "prompt": "What belongs in an AI evaluation set?",
      "answer": "Representative ordinary, ambiguous, missing-evidence, unauthorized, outdated, and adversarial cases with expected behavior.",
      "explanation": "Testing only attractive examples leaves important boundaries unexamined.",
      "lessonId": "dbxfe-m07-l03",
      "sectionId": "dbxfe-m07-l03-understand",
      "conceptIds": [
        "dbxfe-m07-l03-concept"
      ],
