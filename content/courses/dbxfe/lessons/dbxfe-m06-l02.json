  "questions": [
    {
      "id": "dbxfe-m06-l02-q1",
      "revision": "1",
      "prompt": "An admin can read a table. What remains unproven?",
      "options": [
        {
          "id": "dbxfe-m06-l02-q1-a",
          "text": "That the intended analyst can read it with appropriately limited privileges.",
          "rationale": "Broad administrative success does not validate the consumer identity."
        },
        {
          "id": "dbxfe-m06-l02-q1-b",
          "text": "That a query can ever execute.",
          "rationale": "The admin run supplies narrow functional evidence of execution."
        },
        {
          "id": "dbxfe-m06-l02-q1-c",
          "text": "That the administrator completed this particular table-read operation.",
          "rationale": "The successful admin query establishes that narrow observation; it does not establish the analyst\u2019s access."
        }
      ],
      "correctOptionId": "dbxfe-m06-l02-q1-a",
      "conceptIds": [
        "dbxfe-m06-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-privileges"
      ]
    },
    {
      "id": "dbxfe-m06-l02-q2",
      "revision": "1",
      "prompt": "A reader has SELECT but lacks USE SCHEMA under the documented model. What is a suitable next step?",
      "options": [
        {
          "id": "dbxfe-m06-l02-q2-b",
          "text": "Grant global administration automatically.",
          "rationale": "That is broader than the stated need."
        },
        {
          "id": "dbxfe-m06-l02-q2-c",
          "text": "Remove all network restrictions.",
          "rationale": "The stated missing privilege is an authorization issue, not proof of a network cause."
        },
        {
          "id": "dbxfe-m06-l02-q2-a",
          "text": "Have the owner verify and grant the required narrow usage privilege if permitted.",
          "rationale": "Parent usage is part of the access contract and should be scoped."
        }
      ],
      "correctOptionId": "dbxfe-m06-l02-q2-a",
      "conceptIds": [
        "dbxfe-m06-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-privileges"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m06-l02-card1",
      "revision": "1",
      "prompt": "What does least privilege mean in this lesson?",
      "answer": "Granting the supported scope needed for the intended work and checking that unrelated actions remain denied.",
      "explanation": "A positive test alone does not prove the boundary.",
      "lessonId": "dbxfe-m06-l02",
      "sectionId": "dbxfe-m06-l02-understand",
      "conceptIds": [
        "dbxfe-m06-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-privileges"
      ]
    },
    {
      "id": "dbxfe-m06-l02-card2",
      "revision": "1",
      "prompt": "What table-reading privileges accompany SELECT?",
      "answer": "Relevant USE CATALOG and USE SCHEMA privileges under the documented privilege model.",
      "explanation": "Workspace, compute, identity, and network requirements are separate checks.",
      "lessonId": "dbxfe-m06-l02",
      "sectionId": "dbxfe-m06-l02-understand",
      "conceptIds": [
        "dbxfe-m06-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-privileges"
      ]
    },
    {
      "id": "dbxfe-m06-l02-card3",
      "revision": "1",
      "prompt": "Why test with a workload identity?",
      "answer": "Its effective permissions can differ from a human administrator\u2019s.",
      "explanation": "Validate the identity that will actually run the operation.",
