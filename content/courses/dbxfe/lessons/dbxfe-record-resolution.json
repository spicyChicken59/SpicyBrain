  "questions": [
    {
      "id": "dbxfe-record-resolution-foundation-q1",
      "revision": "1",
      "prompt": "Why must the highest observed version be identified before filtering out invalid quantities?",
      "options": [
        {
          "id": "dbxfe-record-resolution-foundation-q1-a",
          "text": "Otherwise an invalid latest revision can disappear and an older state can be mislabeled current.",
          "rationale": "Current-state uncertainty must remain visible."
        },
        {
          "id": "dbxfe-record-resolution-foundation-q1-b",
          "text": "Because every high version is valid.",
          "rationale": "Ordering does not validate quantity values."
        },
        {
          "id": "dbxfe-record-resolution-foundation-q1-c",
          "text": "Because a negative quantity becomes valid at a higher version.",
          "rationale": "Quantity rules still apply."
        }
      ],
      "correctOptionId": "dbxfe-record-resolution-foundation-q1-a",
      "conceptIds": [
        "dbxfe-record-resolution-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-policy",
        "dbxfe-fact-expectations",
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-record-resolution-foundation-q2",
      "revision": "1",
      "prompt": "What should a UI show after unresolved A leaves only C in the accepted candidate?",
      "options": [
        {
          "id": "dbxfe-record-resolution-foundation-q2-c",
          "text": "Delete the conflict evidence after logging a count.",
          "rationale": "Losing payload evidence prevents reliable adjudication and replay."
        },
        {
          "id": "dbxfe-record-resolution-foundation-q2-a",
          "text": "Block a new current report and label any last verified published snapshot stale.",
          "rationale": "The diagnostic candidate is not complete authorized current reporting state."
        },
        {
          "id": "dbxfe-record-resolution-foundation-q2-b",
          "text": "Publish C-only totals as if A never existed.",
          "rationale": "That hides a known unresolved key and changes coverage silently."
        }
      ],
      "correctOptionId": "dbxfe-record-resolution-foundation-q2-a",
      "conceptIds": [
        "dbxfe-record-resolution-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-policy",
        "dbxfe-fact-expectations",
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-record-resolution-foundation-card1",
      "revision": "1",
      "prompt": "How does row quarantine differ from unresolved current state?",
      "answer": "Quarantine explains invalid deliveries; unresolved state means current truth cannot be established under policy.",
      "explanation": "The publication consequence depends on the authored coverage contract.",
      "lessonId": "dbxfe-record-resolution",
      "sectionId": "dbxfe-record-resolution-stages",
      "conceptIds": [
        "dbxfe-record-resolution-foundation-concept"
