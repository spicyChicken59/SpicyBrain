  "questions": [
    {
      "id": "dbxfe-record-resolution-foundation-q1",
      "revision": "1",
      "prompt": "Why must the highest observed version be identified before filtering out invalid quantities?",
      "options": [
        {
          "id": "dbxfe-record-resolution-foundation-q1-a",
          "text": "Otherwise an invalid latest revision can disappear and an older state can be mislabeled current.",
          "rationale": "Current-state uncertainty must remain visible."
        },
        {
          "id": "dbxfe-record-resolution-foundation-q1-b",
          "text": "Because every high version is valid.",
          "rationale": "Ordering does not validate quantity values."
        },
        {
          "id": "dbxfe-record-resolution-foundation-q1-c",
          "text": "Because a negative quantity becomes valid at a higher version.",
          "rationale": "Quantity rules still apply."
        }
      ],
      "correctOptionId": "dbxfe-record-resolution-foundation-q1-a",
      "conceptIds": [
        "dbxfe-record-resolution-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-policy",
        "dbxfe-fact-expectations",
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-record-resolution-foundation-q2",
      "revision": "2",
      "prompt": "Two conflicting deliveries share an event ID but have no usable inspection key. The diagnostic candidate includes valid A v3 and C at 22/1; a verified 20/1 report already exists. What may be published?",
      "options": [
        {
          "id": "dbxfe-record-resolution-foundation-q2-c",
          "text": "Delete the two quarantined deliveries and publish 22/1.",
          "rationale": "Removing contradictory evidence does not resolve the immutable-event conflict or justify a current report."
        },
        {
          "id": "dbxfe-record-resolution-foundation-q2-a",
          "text": "Block a new current report and retain the verified 20/1 snapshot as stale/previous.",
          "rationale": "Global conflict evidence blocks publication even with no unresolved inspection keys; 22/1 remains diagnostic."
        },
        {
          "id": "dbxfe-record-resolution-foundation-q2-b",
          "text": "Publish 22/1 because the unresolved-key list is empty.",
          "rationale": "The missing key prevents attribution, not conflict detection; an empty key list does not establish trustworthy provenance."
        }
      ],
      "correctOptionId": "dbxfe-record-resolution-foundation-q2-a",
      "conceptIds": [
        "dbxfe-record-resolution-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-policy",
        "dbxfe-fact-expectations",
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-record-resolution-foundation-card1",
      "revision": "2",
      "prompt": "How do quarantine, provenance conflicts and unresolved inspection keys differ?",
      "answer": "Quarantine records invalid deliveries; conflicts record contradictory identity evidence; unresolved keys name affected inspections only when usable keys exist.",
      "explanation": "Publication checks both conflicts and unresolved keys. A conflict without an attributable inspection key still blocks a new current report, while a nonconflicting disclosed exclusion such as baseline B need not.",
      "lessonId": "dbxfe-record-resolution",
      "sectionId": "dbxfe-record-resolution-stages",
      "conceptIds": [
        "dbxfe-record-resolution-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-policy",
        "dbxfe-fact-expectations",
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-record-resolution-foundation-card2",
      "revision": "1",
      "prompt": "Where must duplicate/conflict checks look for cross-batch reliability?",
      "answer": "Across retained relevant evidence, not just the newest batch.",
      "explanation": "A repeated identity can conflict with a payload received earlier.",
      "lessonId": "dbxfe-record-resolution",
      "sectionId": "dbxfe-record-resolution-stages",
      "conceptIds": [
        "dbxfe-record-resolution-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-policy",
        "dbxfe-fact-expectations",
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-record-resolution-foundation-card3",
      "revision": "1",
      "prompt": "Which replay outputs are invariant here?",
      "answer": "Accepted business rows, totals and resulting business snapshot identity for identical evidence.",
      "explanation": "Raw delivery count and operational audit observations may increase.",
