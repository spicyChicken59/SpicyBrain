  "questions": [
    {
      "id": "dbxfe-m01-l03-q1",
      "revision": "1",
      "prompt": "Which is a decision gate rather than an activity?",
      "options": [
        {
          "id": "dbxfe-m01-l03-q1-c",
          "text": "A slide deck was sent.",
          "rationale": "Sending a file says nothing about acceptance or remaining uncertainty."
        },
        {
          "id": "dbxfe-m01-l03-q1-a",
          "text": "The sponsor accepts the metric and the evidence needed for the pilot.",
          "rationale": "Acceptance connects an outcome to the next decision."
        },
        {
          "id": "dbxfe-m01-l03-q1-b",
          "text": "A two-hour workshop happened.",
          "rationale": "Attendance and duration do not establish a resolved question."
        }
      ],
      "correctOptionId": "dbxfe-m01-l03-q1-a",
      "conceptIds": [
        "dbxfe-m01-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m01-l03-q2",
      "revision": "1",
      "prompt": "Sample reconciliation passed, but failed-run ownership is missing. What follows?",
      "options": [
        {
          "id": "dbxfe-m01-l03-q2-a",
          "text": "Preserve the result and keep readiness conditional on an operating plan.",
          "rationale": "Different kinds of evidence answer different risks."
        },
        {
          "id": "dbxfe-m01-l03-q2-b",
          "text": "Call the engagement fully validated.",
          "rationale": "One success does not resolve operational ownership."
        },
        {
          "id": "dbxfe-m01-l03-q2-c",
          "text": "Delete the pilot result as a failure.",
          "rationale": "The result is useful within its scope and should remain recorded."
        }
      ],
      "correctOptionId": "dbxfe-m01-l03-q2-a",
      "conceptIds": [
        "dbxfe-m01-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m01-l03-card1",
      "revision": "1",
      "prompt": "What is a decision gate?",
      "answer": "A stated question, evidence requirement, accepting stakeholder, and possible outcomes.",
      "explanation": "It separates meaningful progress from activity.",
      "lessonId": "dbxfe-m01-l03",
      "sectionId": "dbxfe-m01-l03-understand",
      "conceptIds": [
        "dbxfe-m01-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m01-l03-card2",
      "revision": "1",
      "prompt": "Can a failed technical test be useful?",
      "answer": "Yes, if it exposes a constraint or changes the decision before a larger commitment.",
      "explanation": "Preserve the failure and the response rather than hiding it.",
      "lessonId": "dbxfe-m01-l03",
      "sectionId": "dbxfe-m01-l03-understand",
      "conceptIds": [
        "dbxfe-m01-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m01-l03-card3",
      "revision": "1",
      "prompt": "What should a delivery handoff distinguish?",
      "answer": "Accepted scope, observed results, proposed work, and unresolved risks with owners.",
      "explanation": "A new teammate needs to know what is real and what still needs action.",
      "lessonId": "dbxfe-m01-l03",
