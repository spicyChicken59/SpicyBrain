      ]
    },
    {
      "id": "dbxfe-m04-l01-card2",
      "revision": "1",
      "prompt": "What does lazy DataFrame evaluation mean?",
      "answer": "Transformations build a plan; an action triggers execution.",
      "explanation": "It does not mean that correctness or resource usage is automatically safe.",
      "lessonId": "dbxfe-m04-l01",
      "sectionId": "dbxfe-m04-l01-understand",
