      "id": "dbxfe-m04-l01-card1",
      "revision": "1",
      "prompt": "What is transformation grain?",
      "answer": "The meaning of one row before and after a transformation.",
      "explanation": "A change in grain determines whether totals and joins remain valid.",
      "lessonId": "dbxfe-m04-l01",
      "sectionId": "dbxfe-m04-l01-understand",
