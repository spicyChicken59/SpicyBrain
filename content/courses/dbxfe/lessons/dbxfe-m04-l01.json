    {
      "id": "dbxfe-m04-l01-foundation-card1",
      "revision": "1",
      "prompt": "Which step can change output columns without aggregating inspection rows?",
      "answer": "Projection can select, rename and derive columns while preserving inspection grain.",
      "explanation": "Grouping by plant is the later step that changes one row’s meaning.",
