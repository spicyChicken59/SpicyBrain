  "questions": [
    {
      "id": "dbxfe-m04-l01-q1",
      "revision": "1",
      "prompt": "What is North’s unit-weighted defect rate for 12/1 and 8/0 inspected/defective units?",
      "options": [
        {
          "id": "dbxfe-m04-l01-q1-a",
          "text": "5%.",
          "rationale": "There is one defective unit out of twenty inspected units."
        },
        {
          "id": "dbxfe-m04-l01-q1-b",
          "text": "About 4.17%.",
          "rationale": "That is the unweighted average of the two row percentages."
        },
        {
          "id": "dbxfe-m04-l01-q1-c",
          "text": "10%.",
          "rationale": "There are not two defective units in the accepted North inputs."
        }
      ],
      "correctOptionId": "dbxfe-m04-l01-q1-a",
      "conceptIds": [
        "dbxfe-m04-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-spark-sql",
        "dbxfe-fact-pyspark"
      ]
    },
    {
      "id": "dbxfe-m04-l01-q2",
      "revision": "1",
      "prompt": "Why inspect join-key uniqueness before joining inspections to events?",
      "options": [
        {
          "id": "dbxfe-m04-l01-q2-b",
          "text": "Joins always remove duplicates automatically.",
          "rationale": "Ordinary joins do not establish business uniqueness."
        },
        {
          "id": "dbxfe-m04-l01-q2-c",
          "text": "Lazy evaluation guarantees correct business totals.",
          "rationale": "Execution planning does not choose the correct grain or denominator."
        },
        {
          "id": "dbxfe-m04-l01-q2-a",
          "text": "A many-to-many join can multiply inspection rows and inflate totals.",
          "rationale": "The output grain must be intentional."
        }
      ],
      "correctOptionId": "dbxfe-m04-l01-q2-a",
      "conceptIds": [
        "dbxfe-m04-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-spark-sql",
        "dbxfe-fact-pyspark"
      ]
    },
    {
      "id": "dbxfe-m04-l01-foundation-q1",
      "revision": "1",
      "prompt": "A and C represent 14/1 and 8/0 current accepted inspections. Which North rate matches the unit metric?",
      "options": [
        {
          "id": "dbxfe-m04-l01-foundation-q1-a",
          "text": "1 divided by 22.",
          "rationale": "The denominator is total inspected units."
        },
        {
          "id": "dbxfe-m04-l01-foundation-q1-b",
          "text": "The average of 1/14 and 0/8.",
          "rationale": "That weights inspections equally, which is a different metric."
        },
        {
          "id": "dbxfe-m04-l01-foundation-q1-c",
          "text": "2 divided by 22.",
          "rationale": "There is one defective unit, not two."
        }
      ],
      "correctOptionId": "dbxfe-m04-l01-foundation-q1-a",
      "conceptIds": [
        "dbxfe-m04-l01-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m04-l01-foundation-q2",
      "revision": "1",
      "prompt": "Why explicitly compare result types as well as values?",
      "options": [
        {
          "id": "dbxfe-m04-l01-foundation-q2-c",
          "text": "Types matter only when the dataset has more than one million rows.",
          "rationale": "The type contract matters at every size."
        },
        {
          "id": "dbxfe-m04-l01-foundation-q2-a",
          "text": "A cast or aggregation can change the downstream contract even when displayed values look equal.",
          "rationale": "12 as a string is not the same typed value as bigint 12."
        },
        {
          "id": "dbxfe-m04-l01-foundation-q2-b",
          "text": "Equal displayed values always prove schemas match.",
          "rationale": "Display formatting hides types."
        }
      ],
      "correctOptionId": "dbxfe-m04-l01-foundation-q2-a",
      "conceptIds": [
        "dbxfe-m04-l01-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    }
