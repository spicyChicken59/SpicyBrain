      ]
    },
    {
      "id": "dbxfe-m04-l01-card3",
      "revision": "1",
      "prompt": "Why calculate a ratio from summed numerator and denominator?",
      "answer": "When the metric is unit-weighted, it preserves the intended population weighting.",
      "explanation": "An average of row percentages can answer a different question.",
      "lessonId": "dbxfe-m04-l01",
      "sectionId": "dbxfe-m04-l01-understand",
