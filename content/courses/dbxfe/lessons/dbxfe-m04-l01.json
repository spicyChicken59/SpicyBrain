    },
    {
      "id": "dbxfe-m04-l01-foundation-card3",
      "revision": "1",
      "prompt": "What makes the two-interface test meaningful?",
      "answer": "Independent expected rows, explicit ordering and schema comparison on the same inputs.",
      "explanation": "Calling both interfaces does not establish correctness without an external expectation.",
      "lessonId": "dbxfe-m04-l01",
