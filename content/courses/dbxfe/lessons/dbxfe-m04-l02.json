  "questions": [
    {
      "id": "dbxfe-m04-l02-q1",
      "revision": "1",
      "prompt": "Which rule prevents a delayed older correction from overwriting a newer state?",
      "options": [
        {
          "id": "dbxfe-m04-l02-q1-b",
          "text": "Always use the latest arrival.",
          "rationale": "A delayed older event can arrive last."
        },
        {
          "id": "dbxfe-m04-l02-q1-c",
          "text": "Sum every received row.",
          "rationale": "Duplicates and revisions would inflate the report."
        },
        {
          "id": "dbxfe-m04-l02-q1-a",
          "text": "Use the validated source key and revision ordering.",
          "rationale": "Arrival time can differ from source change order."
        }
      ],
      "correctOptionId": "dbxfe-m04-l02-q1-a",
      "conceptIds": [
        "dbxfe-m04-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-connect",
        "dbxfe-fact-merge"
      ]
    },
    {
      "id": "dbxfe-m04-l02-q2",
      "revision": "1",
      "prompt": "What is the accepted aggregate after applying the stated rules to the five synthetic rows?",
      "options": [
        {
          "id": "dbxfe-m04-l02-q2-c",
          "text": "23 inspected and 2 defective.",
          "rationale": "It changes the negative record rather than quarantining it."
        },
        {
          "id": "dbxfe-m04-l02-q2-a",
          "text": "20 inspected and 1 defective; B quarantined.",
          "rationale": "A version 2 plus C are valid; the duplicate and superseded revision are not added."
        },
        {
          "id": "dbxfe-m04-l02-q2-b",
          "text": "37 inspected and 4 defective.",
          "rationale": "That combines raw deliveries without applying the revision and quality rules."
        }
      ],
      "correctOptionId": "dbxfe-m04-l02-q2-a",
      "conceptIds": [
        "dbxfe-m04-l02-concept"
      ],
      "claimIds": [
