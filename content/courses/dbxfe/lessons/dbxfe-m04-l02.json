  "cards": [
    {
      "id": "dbxfe-m04-l02-card1",
      "revision": "1",
      "prompt": "What does CDC represent?",
      "answer": "Changes in a source, including inserts, updates, and deletes when supported by that source/connector.",
      "explanation": "An incremental timestamp query does not automatically capture every change type.",
      "lessonId": "dbxfe-m04-l02",
      "sectionId": "dbxfe-m04-l02-understand",
      "conceptIds": [
        "dbxfe-m04-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-connect",
        "dbxfe-fact-merge"
      ]
    },
    {
      "id": "dbxfe-m04-l02-card2",
      "revision": "1",
      "prompt": "Why separate event identity from business identity?",
      "answer": "A repeated delivery and a revised business record are different cases.",
      "explanation": "You need to recognize both replay duplicates and legitimate corrections.",
      "lessonId": "dbxfe-m04-l02",
      "sectionId": "dbxfe-m04-l02-understand",
      "conceptIds": [
        "dbxfe-m04-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-connect",
        "dbxfe-fact-merge"
      ]
    },
    {
      "id": "dbxfe-m04-l02-card3",
      "revision": "1",
      "prompt": "What must be decided before using MERGE?",
      "answer": "The source key, correction order, and handling of ambiguous or invalid matches.",
      "explanation": "The statement applies a rule; it does not decide the business rule for you.",
      "lessonId": "dbxfe-m04-l02",
      "sectionId": "dbxfe-m04-l02-understand",
      "conceptIds": [
        "dbxfe-m04-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-connect",
        "dbxfe-fact-merge"
      ]
    },
    {
      "id": "dbxfe-m04-l02-foundation-card1",
      "revision": "1",
      "prompt": "Two different event IDs contain the same inspection, revision and quantities. Are they two inspections?",
      "answer": "No; they are redundant business evidence for the same replacement state.",
      "explanation": "Distinct delivery identity does not change business grain or add units.",
      "lessonId": "dbxfe-m04-l02",
      "sectionId": "dbxfe-m04-l02-foundation-contract",
      "conceptIds": [
        "dbxfe-m04-l02-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-connect",
        "dbxfe-fact-merge",
        "dbxfe-foundation-policy",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m04-l02-foundation-card2",
      "revision": "1",
      "prompt": "What does version mean in Cinderline?",
      "answer": "A positive integer ordering complete replacement states within one inspection.",
      "explanation": "It is neither a table commit version nor an additive amount.",
      "lessonId": "dbxfe-m04-l02",
      "sectionId": "dbxfe-m04-l02-foundation-contract",
      "conceptIds": [
        "dbxfe-m04-l02-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-connect",
        "dbxfe-fact-merge",
        "dbxfe-foundation-policy",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m04-l02-foundation-card3",
      "revision": "1",
      "prompt": "Does a missing key in an incremental batch imply deletion?",
      "answer": "No; absence is not a deletion instruction under this contract.",
      "explanation": "A delete needs an explicit source operation and agreed handling.",
