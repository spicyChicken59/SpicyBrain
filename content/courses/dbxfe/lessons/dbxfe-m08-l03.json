  "questions": [
    {
      "id": "dbxfe-m08-l03-q1",
      "revision": "1",
      "prompt": "Why can matching totals be insufficient reconciliation?",
      "options": [
        {
          "id": "dbxfe-m08-l03-q1-a",
          "text": "Different or missing records can offset each other.",
          "rationale": "Population and key checks reveal errors hidden by aggregates."
        },
        {
          "id": "dbxfe-m08-l03-q1-b",
          "text": "Totals can never be useful.",
          "rationale": "They are useful alongside other agreed checks."
        },
        {
          "id": "dbxfe-m08-l03-q1-c",
          "text": "A screenshot of equal totals proves identical lineage.",
          "rationale": "The screenshot does not establish underlying record identity."
        }
      ],
      "correctOptionId": "dbxfe-m08-l03-q1-a",
      "conceptIds": [
        "dbxfe-m08-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-reliability"
      ]
    },
    {
      "id": "dbxfe-m08-l03-q2",
      "revision": "1",
      "prompt": "Which rollback plan is concrete?",
      "options": [
        {
          "id": "dbxfe-m08-l03-q2-b",
          "text": "A sentence saying \u201cwe can always go back.\u201d",
          "rationale": "It provides no viable recovery sequence."
        },
        {
          "id": "dbxfe-m08-l03-q2-c",
          "text": "Deleting the old path immediately after one good demo.",
          "rationale": "That can remove the fallback before acceptance evidence exists."
        },
        {
          "id": "dbxfe-m08-l03-q2-a",
          "text": "Named triggers, owner, restoration steps, data consequences, and communication.",
          "rationale": "It describes what people will actually do when the gate fails."
        }
      ],
      "correctOptionId": "dbxfe-m08-l03-q2-a",
      "conceptIds": [
        "dbxfe-m08-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-reliability"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m08-l03-card1",
      "revision": "1",
      "prompt": "What makes a migration reversible?",
      "answer": "A bounded change with a viable fallback and tested conditions for returning to it.",
      "explanation": "A rollback promise without a maintained path is weak.",
      "lessonId": "dbxfe-m08-l03",
      "sectionId": "dbxfe-m08-l03-understand",
      "conceptIds": [
        "dbxfe-m08-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-reliability"
      ]
    },
    {
      "id": "dbxfe-m08-l03-card2",
      "revision": "1",
      "prompt": "What should a dual run compare?",
      "answer": "The same population and definitions, using keys, totals, timing, corrections, and accepted exceptions.",
      "explanation": "Compare meaning and coverage, not just display values.",
      "lessonId": "dbxfe-m08-l03",
      "sectionId": "dbxfe-m08-l03-understand",
      "conceptIds": [
        "dbxfe-m08-l03-concept"
      ],
