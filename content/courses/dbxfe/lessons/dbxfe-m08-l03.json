      ]
    },
    {
      "id": "dbxfe-m08-l03-card3",
      "revision": "1",
      "prompt": "Why separate read-path and write-path migration?",
      "answer": "Moving reporting access differs from transferring authority for operational updates.",
      "explanation": "Write ownership and transition changes can complicate rollback.",
