  "questions": [
    {
      "id": "dbxfe-versioned-updates-foundation-q1",
      "revision": "1",
      "prompt": "Why omit WHEN NOT MATCHED BY SOURCE DELETE from this incremental example?",
      "options": [
        {
          "id": "dbxfe-versioned-updates-foundation-q1-a",
          "text": "A key’s absence from one incremental batch does not instruct deletion.",
          "rationale": "The source contract contains only replacement states, not a complete target snapshot."
        },
        {
          "id": "dbxfe-versioned-updates-foundation-q1-b",
          "text": "MERGE can never delete rows in any environment.",
          "rationale": "Some supported MERGE clauses can delete; this source meaning does not justify doing so."
        },
        {
          "id": "dbxfe-versioned-updates-foundation-q1-c",
          "text": "C should be deleted whenever only A changes.",
          "rationale": "That confuses a partial change batch with the whole source population."
        }
      ],
      "correctOptionId": "dbxfe-versioned-updates-foundation-q1-a",
      "conceptIds": [
        "dbxfe-versioned-updates-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-merge",
        "dbxfe-foundation-policy",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-versioned-updates-foundation-q2",
      "revision": "1",
      "prompt": "A same-version differing payload causes no SQL update under the greater-version guard. Is that sufficient?",
      "options": [
        {
          "id": "dbxfe-versioned-updates-foundation-q2-c",
          "text": "Yes; timestamps always establish which same-version payload is correct.",
          "rationale": "Arrival time has no adjudication authority in this contract."
        },
        {
          "id": "dbxfe-versioned-updates-foundation-q2-a",
          "text": "No; pre-merge conflict detection must block new current publication.",
          "rationale": "A no-op can hide contradictory source evidence."
        },
        {
          "id": "dbxfe-versioned-updates-foundation-q2-b",
          "text": "Yes; unchanged values prove all evidence agrees.",
          "rationale": "The statement’s action does not prove agreement."
        }
      ],
      "correctOptionId": "dbxfe-versioned-updates-foundation-q2-a",
      "conceptIds": [
        "dbxfe-versioned-updates-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-merge",
        "dbxfe-foundation-policy",
        "dbxfe-fiction"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-versioned-updates-foundation-card1",
      "revision": "1",
      "prompt": "What must a MERGE source establish before target matching?",
      "answer": "A unique, valid, unambiguous row per target business key.",
      "explanation": "MERGE applies a relation; it does not invent the source contract.",
      "lessonId": "dbxfe-versioned-updates",
      "sectionId": "dbxfe-versioned-updates-guard",
      "conceptIds": [
        "dbxfe-versioned-updates-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-merge",
        "dbxfe-foundation-policy",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-versioned-updates-foundation-card2",
      "revision": "1",
      "prompt": "What protects newer state from older arrivals?",
      "answer": "A source-revision guard together with retained-evidence reconciliation.",
      "explanation": "Event arrival time is not the replacement order.",
      "lessonId": "dbxfe-versioned-updates",
      "sectionId": "dbxfe-versioned-updates-guard",
      "conceptIds": [
        "dbxfe-versioned-updates-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-merge",
        "dbxfe-foundation-policy",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-versioned-updates-foundation-card3",
      "revision": "1",
      "prompt": "What is the equal-version policy?",
      "answer": "Identical business payloads are no-ops; differing payloads are conflicts.",
      "explanation": "A no-op write alone is not evidence that equal-version records agree.",
      "lessonId": "dbxfe-versioned-updates",
