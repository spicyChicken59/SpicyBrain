    {
      "id": "dbxfe-m04-l03-foundation-card2",
      "revision": "1",
      "prompt": "Why key a local notification by snapshot identity?",
      "answer": "So repeating the same intended publication does not add a second modeled effect.",
      "explanation": "Durable real delivery requires additional recipient/outbox guarantees.",
