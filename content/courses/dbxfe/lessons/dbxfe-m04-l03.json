      "id": "dbxfe-m04-l03-card1",
      "revision": "1",
      "prompt": "What is idempotency?",
      "answer": "Repeating an operation has the same intended effect as applying it once.",
      "explanation": "A retry setting alone does not guarantee that property.",
      "lessonId": "dbxfe-m04-l03",
      "sectionId": "dbxfe-m04-l03-understand",
      "conceptIds": [
