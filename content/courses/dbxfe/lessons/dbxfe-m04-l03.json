        "dbxfe-fact-expectations"
      ]
    },
    {
      "id": "dbxfe-m04-l03-card2",
      "revision": "1",
      "prompt": "What does orchestration add?",
      "answer": "Coordination of task dependencies, triggers, execution, and monitoring.",
      "explanation": "It still needs correct task logic and clear operating ownership.",
