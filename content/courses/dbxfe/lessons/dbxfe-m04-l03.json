  "questions": [
    {
      "id": "dbxfe-m04-l03-q1",
      "revision": "1",
      "prompt": "Why is a retry policy insufficient to establish idempotency?",
      "options": [
        {
          "id": "dbxfe-m04-l03-q1-c",
          "text": "A successful scheduler status proves repeated business effects cannot occur.",
          "rationale": "Task status alone does not establish idempotent business behavior."
        },
        {
          "id": "dbxfe-m04-l03-q1-a",
          "text": "It controls repetition, not the effect of repeating each write or external action.",
          "rationale": "The task itself must handle repeated inputs and side effects safely."
        },
        {
          "id": "dbxfe-m04-l03-q1-b",
          "text": "Every retry automatically rolls back all earlier external effects.",
          "rationale": "A retry does not necessarily undo a notification or other effect outside the table transaction."
        }
      ],
      "correctOptionId": "dbxfe-m04-l03-q1-a",
      "conceptIds": [
        "dbxfe-m04-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-jobs",
        "dbxfe-fact-pipelines",
        "dbxfe-fact-expectations"
      ]
    },
    {
      "id": "dbxfe-m04-l03-q2",
      "revision": "1",
      "prompt": "Four records fail a quantity rule. Which response preserves truthful reporting?",
      "options": [
        {
          "id": "dbxfe-m04-l03-q2-a",
          "text": "Retain the rejected records, disclose coverage, and follow the agreed publish/withhold policy.",
          "rationale": "This preserves evidence and aligns with the report contract."
        },
        {
          "id": "dbxfe-m04-l03-q2-b",
          "text": "Delete them and report 100% valid input.",
          "rationale": "That hides invalid input and changes the denominator."
        },
        {
          "id": "dbxfe-m04-l03-q2-c",
          "text": "Change their quantities to zero without approval.",
          "rationale": "That invents business values rather than correcting the source."
        }
      ],
      "correctOptionId": "dbxfe-m04-l03-q2-a",
      "conceptIds": [
        "dbxfe-m04-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-jobs",
        "dbxfe-fact-pipelines",
        "dbxfe-fact-expectations"
      ]
    },
    {
      "id": "dbxfe-m04-l03-foundation-q1",
      "revision": "1",
      "prompt": "Failure happens after publishing the new report but before its local notification. What is true?",
      "options": [
        {
          "id": "dbxfe-m04-l03-foundation-q1-a",
          "text": "The new data snapshot can be current while its notification remains pending.",
          "rationale": "Publication and the modeled external effect are separate boundaries."
        },
        {
          "id": "dbxfe-m04-l03-foundation-q1-b",
          "text": "All data must still be the old snapshot.",
          "rationale": "The named publication boundary completed."
        },
        {
          "id": "dbxfe-m04-l03-foundation-q1-c",
          "text": "Retry automatically sends exactly one message through every real provider.",
          "rationale": "The local model proves no real provider behavior."
        }
      ],
      "correctOptionId": "dbxfe-m04-l03-foundation-q1-a",
      "conceptIds": [
        "dbxfe-m04-l03-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-jobs",
        "dbxfe-fact-pipelines",
        "dbxfe-fact-expectations",
        "dbxfe-foundation-policy",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m04-l03-foundation-q2",
      "revision": "1",
      "prompt": "Why is (order_id, line_id) the transfer key?",
      "options": [
        {
          "id": "dbxfe-m04-l03-foundation-q2-c",
          "text": "The last arriving line replaces every other line in the order.",
          "rationale": "Arrival order is not a replacement rule for unrelated keys."
        },
        {
          "id": "dbxfe-m04-l03-foundation-q2-a",
          "text": "An order may contain multiple independently revised lines.",
          "rationale": "Resolving only by order collapses legitimate line state."
        },
        {
          "id": "dbxfe-m04-l03-foundation-q2-b",
          "text": "Line identity is irrelevant once prices are integers.",
          "rationale": "Numeric representation does not establish entity grain."
        }
      ],
      "correctOptionId": "dbxfe-m04-l03-foundation-q2-a",
      "conceptIds": [
        "dbxfe-m04-l03-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-jobs",
        "dbxfe-fact-pipelines",
        "dbxfe-fact-expectations",
        "dbxfe-foundation-policy",
        "dbxfe-fiction"
      ]
    }
