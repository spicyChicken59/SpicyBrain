        "dbxfe-fact-spark-sql"
      ]
    },
    {
      "id": "dbxfe-m03-l02-card3",
      "revision": "1",
      "prompt": "What must be checked before enabling a table feature?",
      "answer": "Compatibility of every required reader and writer.",
      "explanation": "A feature that helps one engine can affect other clients.",
      "lessonId": "dbxfe-m03-l02",
      "sectionId": "dbxfe-m03-l02-understand",
      "conceptIds": [
        "dbxfe-m03-l02-concept"
