        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m03-l02-foundation-card3",
      "revision": "1",
      "prompt": "A replacement file exists but its transaction never committed. What can a current reader infer?",
      "answer": "Physical file creation alone does not establish a new committed table snapshot.",
      "explanation": "The last committed snapshot remains the reading basis; investigate failed writes through supported APIs.",
