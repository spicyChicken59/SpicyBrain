  "questions": [
    {
      "id": "dbxfe-m03-l02-q1",
      "revision": "1",
      "prompt": "What does a successful transactional table write fail to prove?",
      "options": [
        {
          "id": "dbxfe-m03-l02-q1-a",
          "text": "That the source’s business meaning and values are correct.",
          "rationale": "Atomic table behavior does not validate every business rule."
        },
        {
          "id": "dbxfe-m03-l02-q1-b",
          "text": "That a table update can be committed.",
          "rationale": "The successful write is evidence of that narrow operation."
        },
        {
          "id": "dbxfe-m03-l02-q1-c",
          "text": "That the source record was supplied to the write.",
          "rationale": "The operation used its supplied input, but that input may be wrong."
        }
      ],
      "correctOptionId": "dbxfe-m03-l02-q1-a",
      "conceptIds": [
        "dbxfe-m03-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-delta",
        "dbxfe-fact-delta-protocol",
        "dbxfe-fact-spark-sql"
      ]
    },
    {
      "id": "dbxfe-m03-l02-q2",
      "revision": "1",
      "prompt": "An external reader fails after a table feature change. What should be checked first?",
      "options": [
        {
          "id": "dbxfe-m03-l02-q2-b",
          "text": "Only clearing the dashboard cache.",
          "rationale": "A fresh cache cannot give an incompatible reader support for a newly required table feature."
        },
        {
          "id": "dbxfe-m03-l02-q2-c",
          "text": "Only increasing the query timeout.",
          "rationale": "More time does not resolve an unsupported reader protocol."
        },
        {
          "id": "dbxfe-m03-l02-q2-a",
          "text": "Reader/writer protocol and feature compatibility.",
          "rationale": "A feature can impose requirements on participating clients."
        }
      ],
      "correctOptionId": "dbxfe-m03-l02-q2-a",
      "conceptIds": [
        "dbxfe-m03-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-delta",
        "dbxfe-fact-delta-protocol",
        "dbxfe-fact-spark-sql"
      ]
    },
    {
      "id": "dbxfe-m03-l02-foundation-q1",
      "revision": "1",
      "prompt": "File f0 remains physically present after version 1 retired it. What belongs in a version 1 table read?",
      "options": [
        {
          "id": "dbxfe-m03-l02-foundation-q1-a",
          "text": "Only rows active in the committed version 1 snapshot.",
          "rationale": "Physical presence does not make a file logically current."
        },
        {
          "id": "dbxfe-m03-l02-foundation-q1-b",
          "text": "Every row in f0, f1 and f2.",
          "rationale": "That bypasses the table log and double-counts A."
        },
        {
          "id": "dbxfe-m03-l02-foundation-q1-c",
          "text": "Whichever file has the latest filesystem modification time.",
          "rationale": "Filesystem arrival time does not define the committed table snapshot."
        }
      ],
      "correctOptionId": "dbxfe-m03-l02-foundation-q1-a",
      "conceptIds": [
        "dbxfe-m03-l02-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-delta",
        "dbxfe-fact-delta-protocol",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m03-l02-foundation-q2",
      "revision": "1",
      "prompt": "What happens if a replacement data file is written but its transaction never commits?",
      "options": [
        {
          "id": "dbxfe-m03-l02-foundation-q2-c",
          "text": "The old data is automatically proven invalid.",
          "rationale": "Failure to commit a new change says nothing about the business truth of the prior state."
        },
        {
          "id": "dbxfe-m03-l02-foundation-q2-a",
          "text": "That file alone does not establish a new committed table snapshot.",
          "rationale": "The transaction boundary determines the visible change."
        },
        {
          "id": "dbxfe-m03-l02-foundation-q2-b",
          "text": "The new row automatically becomes current because the bytes exist.",
          "rationale": "Physical writing is not the same as committing table metadata."
        }
      ],
      "correctOptionId": "dbxfe-m03-l02-foundation-q2-a",
      "conceptIds": [
        "dbxfe-m03-l02-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-delta",
        "dbxfe-fact-delta-protocol",
        "dbxfe-fiction"
      ]
    }
