  "cards": [
    {
      "id": "dbxfe-m03-l02-card1",
      "revision": "1",
      "prompt": "What are storage, compute, table format, and governance responsible for?",
      "answer": "Bytes, execution, table behavior, and permitted use respectively.",
      "explanation": "Keep the responsibilities distinct when explaining an architecture.",
      "lessonId": "dbxfe-m03-l02",
      "sectionId": "dbxfe-m03-l02-understand",
      "conceptIds": [
