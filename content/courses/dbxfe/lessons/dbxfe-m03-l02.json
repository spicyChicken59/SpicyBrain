      ]
    },
    {
      "id": "dbxfe-m03-l02-card2",
      "revision": "1",
      "prompt": "Why does ACID not mean business correctness?",
      "answer": "A transaction can reliably commit values whose meaning or source is wrong.",
      "explanation": "Source semantics and validation remain separate work.",
      "lessonId": "dbxfe-m03-l02",
      "sectionId": "dbxfe-m03-l02-understand",
