        "dbxfe-fact-delta-protocol",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m03-l02-foundation-card2",
      "revision": "1",
      "prompt": "How do table version and source revision differ?",
      "answer": "A table version identifies a commit; a source revision orders a business record’s changes.",
      "explanation": "One table commit can contain many business revisions.",
      "lessonId": "dbxfe-m03-l02",
      "sectionId": "dbxfe-m03-l02-foundation-mechanism",
      "conceptIds": [
        "dbxfe-m03-l02-foundation-concept"
      ],
      "claimIds": [
