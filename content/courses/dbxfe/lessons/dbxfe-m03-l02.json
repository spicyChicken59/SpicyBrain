      ]
    },
    {
      "id": "dbxfe-m03-l02-foundation-card1",
      "revision": "1",
      "prompt": "Why does scanning every physical file differ from reading a Delta table?",
      "answer": "The table snapshot includes only logically active data for its committed version.",
      "explanation": "Old or uncommitted physical files are not automatically current rows.",
      "lessonId": "dbxfe-m03-l02",
      "sectionId": "dbxfe-m03-l02-foundation-mechanism",
      "conceptIds": [
        "dbxfe-m03-l02-foundation-concept"
      ],
      "claimIds": [
