  "questions": [
    {
      "id": "dbxfe-m07-l01-q1",
      "revision": "1",
      "prompt": "Why is a post-repair diagnosis invalid as an input to an earlier warning?",
      "options": [
        {
          "id": "dbxfe-m07-l01-q1-a",
          "text": "It was unavailable at prediction time.",
          "rationale": "That leaks later outcome information into the predictor."
        },
        {
          "id": "dbxfe-m07-l01-q1-b",
          "text": "Text fields can never be model inputs.",
          "rationale": "The problem is timing and meaning, not merely text type."
        },
        {
          "id": "dbxfe-m07-l01-q1-c",
          "text": "All maintenance labels are useless.",
          "rationale": "Later labels can be valid outcomes for evaluation, but not earlier inputs."
        }
      ],
      "correctOptionId": "dbxfe-m07-l01-q1-a",
      "conceptIds": [
        "dbxfe-m07-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-ml",
        "dbxfe-fact-leakage"
      ]
    },
    {
      "id": "dbxfe-m07-l01-q2",
      "revision": "1",
      "prompt": "What is a useful role for a baseline?",
      "options": [
        {
          "id": "dbxfe-m07-l01-q2-b",
          "text": "It guarantees every model will improve.",
          "rationale": "A baseline can reveal no useful improvement."
        },
        {
          "id": "dbxfe-m07-l01-q2-c",
          "text": "It replaces the need for a defined target.",
          "rationale": "You still need to know what is being predicted and why."
        },
        {
          "id": "dbxfe-m07-l01-q2-a",
          "text": "It tests whether complexity adds practical predictive value.",
          "rationale": "A model needs a meaningful comparison on the same evaluation basis."
        }
      ],
      "correctOptionId": "dbxfe-m07-l01-q2-a",
      "conceptIds": [
        "dbxfe-m07-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-ml",
        "dbxfe-fact-leakage"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m07-l01-card1",
      "revision": "1",
      "prompt": "What is data leakage?",
      "answer": "Using information in development or evaluation that would not be available for the intended prediction.",
      "explanation": "A strong-looking score can be invalid if the timing is wrong.",
      "lessonId": "dbxfe-m07-l01",
      "sectionId": "dbxfe-m07-l01-understand",
      "conceptIds": [
        "dbxfe-m07-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-ml",
        "dbxfe-fact-leakage"
      ]
    },
    {
      "id": "dbxfe-m07-l01-card2",
      "revision": "1",
      "prompt": "Why define the prediction horizon?",
      "answer": "It states how far ahead the outcome is predicted and which inputs are available.",
      "explanation": "A warning must arrive early enough to support a real action.",
      "lessonId": "dbxfe-m07-l01",
      "sectionId": "dbxfe-m07-l01-understand",
