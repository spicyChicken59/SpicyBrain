  "questions": [
    {
      "id": "dbxfe-python-bridge-foundation-q1",
      "revision": "1",
      "prompt": "Why explicitly reject True for inspected_units?",
      "options": [
        {
          "id": "dbxfe-python-bridge-foundation-q1-a",
          "text": "Python treats bool as an integer subtype, but the authored quantity policy does not.",
          "rationale": "A conversion that succeeds can still violate the intended meaning."
        },
        {
          "id": "dbxfe-python-bridge-foundation-q1-b",
          "text": "True always raises an exception in int().",
          "rationale": "int(True) returns 1, which is exactly the hidden coercion this parser avoids."
        },
        {
          "id": "dbxfe-python-bridge-foundation-q1-c",
          "text": "Every nonempty Python value is valid quantity input.",
          "rationale": "Truthiness does not validate a numeric business quantity."
        }
      ],
      "correctOptionId": "dbxfe-python-bridge-foundation-q1-a",
      "conceptIds": [
        "dbxfe-python-bridge-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-python",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-python-bridge-foundation-q2",
      "revision": "1",
      "prompt": "Which test distinguishes a missing field from a present field holding None?",
      "options": [
        {
          "id": "dbxfe-python-bridge-foundation-q2-c",
          "text": "Convert every value to a string first.",
          "rationale": "That loses the original type and does not establish required-field presence."
        },
        {
          "id": "dbxfe-python-bridge-foundation-q2-a",
          "text": "Check membership in the dictionary, then inspect the value.",
          "rationale": "The key can exist even when its value is absent."
        },
        {
          "id": "dbxfe-python-bridge-foundation-q2-b",
          "text": "Use only if not row.get(\"inspected_units\").",
          "rationale": "This merges missing, null and legitimate zero."
        }
      ],
      "correctOptionId": "dbxfe-python-bridge-foundation-q2-a",
      "conceptIds": [
        "dbxfe-python-bridge-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-python",
        "dbxfe-fiction"
      ]
    }
  ],
