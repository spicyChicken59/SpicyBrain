  "questions": [
    {
      "id": "dbxfe-m03-l01-q1",
      "revision": "1",
      "prompt": "Which comparison is most defensible?",
      "options": [
        {
          "id": "dbxfe-m03-l01-q1-c",
          "text": "Choose whichever architecture has the most features.",
          "rationale": "Unused capability can add cost and complexity without value."
        },
        {
          "id": "dbxfe-m03-l01-q1-a",
          "text": "Compare workload requirements, operating capacity, and migration cost, including the current state.",
          "rationale": "Fit depends on the work and constraints, not the category label."
        },
        {
          "id": "dbxfe-m03-l01-q1-b",
          "text": "Assume lakehouse always replaces warehouse.",
          "rationale": "The labels do not establish this workload\u2019s benefit or migration case."
        }
      ],
      "correctOptionId": "dbxfe-m03-l01-q1-a",
      "conceptIds": [
        "dbxfe-m03-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-sql"
      ]
    },
    {
      "id": "dbxfe-m03-l01-q2",
      "revision": "1",
      "prompt": "What could justify broadening the retailer\u2019s evaluation?",
      "options": [
        {
          "id": "dbxfe-m03-l01-q2-a",
          "text": "New sources and teams create a need for governed data reuse.",
          "rationale": "That changes the workload and coordination problem."
        },
        {
          "id": "dbxfe-m03-l01-q2-b",
          "text": "The architecture diagram looks more modern.",
          "rationale": "Appearance is not a business requirement."
        },
        {
          "id": "dbxfe-m03-l01-q2-c",
          "text": "A vendor says all legacy systems are obsolete.",
          "rationale": "A blanket claim does not establish this customer\u2019s needs."
        }
      ],
      "correctOptionId": "dbxfe-m03-l01-q2-a",
      "conceptIds": [
        "dbxfe-m03-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-sql"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m03-l01-card1",
      "revision": "1",
      "prompt": "What is workload fit?",
      "answer": "The match between a design and the actual data work, decisions, constraints, and operating capacity.",
      "explanation": "Category names alone do not establish it.",
      "lessonId": "dbxfe-m03-l01",
      "sectionId": "dbxfe-m03-l01-understand",
      "conceptIds": [
        "dbxfe-m03-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-sql"
      ]
    },
    {
      "id": "dbxfe-m03-l01-card2",
      "revision": "1",
      "prompt": "Why include the current state in a comparison?",
      "answer": "It is a real alternative with migration costs avoided and limitations that can be measured.",
      "explanation": "A fair decision includes the option of making a smaller change.",
      "lessonId": "dbxfe-m03-l01",
      "sectionId": "dbxfe-m03-l01-understand",
      "conceptIds": [
        "dbxfe-m03-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-sql"
      ]
    },
    {
      "id": "dbxfe-m03-l01-card3",
      "revision": "1",
      "prompt": "Does a SQL warehouse capability prove migration value?",
      "answer": "No. Value depends on the workload, evidence, and cost of change.",
      "explanation": "Separate product capability from a customer-specific investment case.",
