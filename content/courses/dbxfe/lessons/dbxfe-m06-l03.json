  "questions": [
    {
      "id": "dbxfe-m06-l03-q1",
      "revision": "1",
      "prompt": "Which AWS statement is accurate at the documented level?",
      "options": [
        {
          "id": "dbxfe-m06-l03-q1-b",
          "text": "All compute always runs in the customer account.",
          "rationale": "That does not describe serverless compute."
        },
        {
          "id": "dbxfe-m06-l03-q1-c",
          "text": "Network reachability automatically grants table privileges.",
          "rationale": "Authorization is a separate boundary."
        },
        {
          "id": "dbxfe-m06-l03-q1-a",
          "text": "Classic and serverless compute use different resource-ownership boundaries.",
          "rationale": "The architecture must reflect the selected compute model."
        }
      ],
      "correctOptionId": "dbxfe-m06-l03-q1-a",
      "conceptIds": [
        "dbxfe-m06-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-architecture",
        "dbxfe-fact-serverless-network",
        "dbxfe-fact-classic-network"
      ]
    },
    {
      "id": "dbxfe-m06-l03-q2",
      "revision": "1",
      "prompt": "A serverless connectivity feature has regional or preview conditions. How should it enter the plan?",
      "options": [
        {
          "id": "dbxfe-m06-l03-q2-c",
          "text": "As identical to the classic network configuration.",
          "rationale": "The two models have different configuration and ownership boundaries."
        },
        {
          "id": "dbxfe-m06-l03-q2-a",
          "text": "As conditional until exact region, entitlement, and requirements are verified.",
          "rationale": "Availability is a material feasibility input."
        },
        {
          "id": "dbxfe-m06-l03-q2-b",
          "text": "As guaranteed because the documentation page exists.",
          "rationale": "A reachable page is not proof of eligibility for this deployment."
        }
      ],
      "correctOptionId": "dbxfe-m06-l03-q2-a",
      "conceptIds": [
        "dbxfe-m06-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-architecture",
        "dbxfe-fact-serverless-network",
        "dbxfe-fact-classic-network"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m06-l03-card1",
      "revision": "1",
      "prompt": "What is a trust boundary?",
      "answer": "A boundary where resource operation or access control responsibility changes.",
      "explanation": "Use it to ask who owns each risk and configuration.",
      "lessonId": "dbxfe-m06-l03",
      "sectionId": "dbxfe-m06-l03-understand",
      "conceptIds": [
        "dbxfe-m06-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-architecture",
        "dbxfe-fact-serverless-network",
        "dbxfe-fact-classic-network"
      ]
    },
    {
      "id": "dbxfe-m06-l03-card2",
      "revision": "1",
      "prompt": "Why is a reachable endpoint not sufficient access evidence?",
      "answer": "The intended identity still needs authorization for the operation.",
      "explanation": "Connectivity and privileges must both be validated, because a path that reaches the service says nothing about which principal may perform the operation.",
      "lessonId": "dbxfe-m06-l03",
      "sectionId": "dbxfe-m06-l03-understand",
      "conceptIds": [
        "dbxfe-m06-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-architecture",
        "dbxfe-fact-serverless-network",
        "dbxfe-fact-classic-network"
      ]
    },
    {
      "id": "dbxfe-m06-l03-card3",
      "revision": "1",
      "prompt": "What must be checked before promising a network feature?",
      "answer": "Exact cloud, region, resource path, entitlement/preview status, configuration, and customer approval.",
      "explanation": "General platform capability does not establish this deployment’s feasibility.",
