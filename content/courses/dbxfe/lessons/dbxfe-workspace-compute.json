  "questions": [
    {
      "id": "dbxfe-workspace-compute-foundation-q1",
      "revision": "1",
      "prompt": "Which statement best describes a saved notebook and a table?",
      "options": [
        {
          "id": "dbxfe-workspace-compute-foundation-q1-a",
          "text": "The notebook defines work; the durable table is separate from the running compute session.",
          "rationale": "A saved definition is not the storage location of all underlying data."
        },
        {
          "id": "dbxfe-workspace-compute-foundation-q1-b",
          "text": "Stopping compute necessarily deletes every table read by the notebook.",
          "rationale": "Durable storage and process lifecycle are distinct."
        },
        {
          "id": "dbxfe-workspace-compute-foundation-q1-c",
          "text": "A notebook title grants its author access to every referenced table.",
          "rationale": "Naming an object does not authorize access."
        }
      ],
      "correctOptionId": "dbxfe-workspace-compute-foundation-q1-a",
      "conceptIds": [
        "dbxfe-workspace-compute-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-architecture",
        "dbxfe-fact-unity",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-workspace-compute-foundation-q2",
      "revision": "1",
      "prompt": "Which AWS boundary is documented for serverless compute?",
      "options": [
        {
          "id": "dbxfe-workspace-compute-foundation-q2-c",
          "text": "It eliminates the need to check resource connectivity and identity.",
          "rationale": "Managed compute still needs permitted resource access."
        },
        {
          "id": "dbxfe-workspace-compute-foundation-q2-a",
          "text": "It runs in a Databricks-managed compute plane.",
          "rationale": "The boundary differs from classic compute in the customer AWS account."
        },
        {
          "id": "dbxfe-workspace-compute-foundation-q2-b",
          "text": "It runs without any compute plane.",
          "rationale": "Serverless describes managed infrastructure, not absence of processing."
        }
      ],
      "correctOptionId": "dbxfe-workspace-compute-foundation-q2-a",
      "conceptIds": [
        "dbxfe-workspace-compute-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-architecture",
        "dbxfe-fact-unity",
        "dbxfe-fiction"
      ]
    }
  ],
