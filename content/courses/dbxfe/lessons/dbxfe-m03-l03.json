  "questions": [
    {
      "id": "dbxfe-m03-l03-q1",
      "revision": "1",
      "prompt": "Which platform story is most useful to operations?",
      "options": [
        {
          "id": "dbxfe-m03-l03-q1-b",
          "text": "A list of every product name.",
          "rationale": "A catalog does not explain which responsibility serves the decision."
        },
        {
          "id": "dbxfe-m03-l03-q1-c",
          "text": "An assurance that governance fixes every metric dispute.",
          "rationale": "Access governance does not decide a business denominator."
        },
        {
          "id": "dbxfe-m03-l03-q1-a",
          "text": "A defined quality calculation, a serving path, and a test of decision usefulness.",
          "rationale": "It ties capability to the customer\u2019s actual work."
        }
      ],
      "correctOptionId": "dbxfe-m03-l03-q1-a",
      "conceptIds": [
        "dbxfe-m03-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-architecture",
        "dbxfe-fact-unity"
      ]
    },
    {
      "id": "dbxfe-m03-l03-q2",
      "revision": "1",
      "prompt": "What should change when explaining the design to security instead of operations?",
      "options": [
        {
          "id": "dbxfe-m03-l03-q2-c",
          "text": "All uncertainty should disappear.",
          "rationale": "Security decisions require uncertainty to be visible."
        },
        {
          "id": "dbxfe-m03-l03-q2-a",
          "text": "The level of detail and relevant evidence, while keeping the same underlying facts.",
          "rationale": "Audience adaptation should preserve truth and assumptions."
        },
        {
          "id": "dbxfe-m03-l03-q2-b",
          "text": "The deployment boundary to sound more reassuring.",
          "rationale": "Changing facts to suit the audience is misleading."
        }
      ],
      "correctOptionId": "dbxfe-m03-l03-q2-a",
      "conceptIds": [
        "dbxfe-m03-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-architecture",
        "dbxfe-fact-unity"
      ]
    }
  ],
