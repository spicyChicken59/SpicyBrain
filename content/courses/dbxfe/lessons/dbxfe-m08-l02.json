      "revision": "1",
      "prompt": "What is an architecture tradeoff?",
      "answer": "A choice among competing outcomes under stated constraints.",
      "explanation": "Explain which requirement justifies the cost of the choice.",
      "lessonId": "dbxfe-m08-l02",
      "sectionId": "dbxfe-m08-l02-understand",
