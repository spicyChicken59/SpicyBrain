    {
      "id": "dbxfe-m08-l02-card3",
      "revision": "1",
      "prompt": "What does recovery add to reliability design?",
      "answer": "Detection, restoration, data-loss limits, and tested procedures for failure.",
      "explanation": "Steady-state success alone does not demonstrate recoverability; a rehearsed failure with a measured restore time and an explicit data-loss window does.",
