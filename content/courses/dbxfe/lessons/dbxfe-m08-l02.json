  "questions": [
    {
      "id": "dbxfe-m08-l02-q1",
      "revision": "1",
      "prompt": "Which alternative is meaningful?",
      "options": [
        {
          "id": "dbxfe-m08-l02-q1-c",
          "text": "A claim that doing nothing has no cost without checking.",
          "rationale": "The current state also has measurable costs and risks."
        },
        {
          "id": "dbxfe-m08-l02-q1-a",
          "text": "A scheduled feed with different source and operating requirements.",
          "rationale": "It changes consequences the customer can assess."
        },
        {
          "id": "dbxfe-m08-l02-q1-b",
          "text": "The same architecture with boxes moved left.",
          "rationale": "Layout is not a technical or business alternative."
        }
      ],
      "correctOptionId": "dbxfe-m08-l02-q1-a",
      "conceptIds": [
        "dbxfe-m08-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-reliability",
        "dbxfe-fact-delta-protocol",
        "dbxfe-fact-cost"
      ]
    },
    {
      "id": "dbxfe-m08-l02-q2",
      "revision": "1",
      "prompt": "What would most justify reconsidering the provisional scheduled design?",
      "options": [
        {
          "id": "dbxfe-m08-l02-q2-a",
          "text": "A verified need for within-shift decisions plus timely source updates and operating support.",
          "rationale": "That changes the constraints that supported the original choice."
        },
        {
          "id": "dbxfe-m08-l02-q2-b",
          "text": "A preference for a more complicated diagram.",
          "rationale": "Complexity is not evidence of fit."
        },
        {
          "id": "dbxfe-m08-l02-q2-c",
          "text": "An unmeasured statement that streaming is always better.",
          "rationale": "The claim ignores the workload and operating context."
        }
      ],
      "correctOptionId": "dbxfe-m08-l02-q2-a",
      "conceptIds": [
        "dbxfe-m08-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-reliability",
        "dbxfe-fact-delta-protocol",
        "dbxfe-fact-cost"
      ]
    }
  ],
