      "revision": "1",
      "prompt": "Why name a reconsideration condition?",
      "answer": "It shows which new evidence would change the recommendation.",
      "explanation": "A defensible decision is conditional rather than ideological.",
      "lessonId": "dbxfe-m08-l02",
      "sectionId": "dbxfe-m08-l02-understand",
