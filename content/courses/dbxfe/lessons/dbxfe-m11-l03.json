  "questions": [
    {
      "id": "dbxfe-m11-l03-q1",
      "revision": "1",
      "prompt": "At 6 hours/week, 48 weeks, $60/hour, and $27,000 year-one cost, what is net illustrative value?",
      "options": [
        {
          "id": "dbxfe-m11-l03-q1-a",
          "text": "-$9,720.",
          "rationale": "6 \u00d7 48 \u00d7 60 = 17,280; subtracting 27,000 yields -9,720."
        },
        {
          "id": "dbxfe-m11-l03-q1-b",
          "text": "$17,280.",
          "rationale": "That is gross labor value before costs."
        },
        {
          "id": "dbxfe-m11-l03-q1-c",
          "text": "$1,800.",
          "rationale": "That is the 10-hour scenario, not the 6-hour case."
        }
      ],
      "correctOptionId": "dbxfe-m11-l03-q1-a",
      "conceptIds": [
        "dbxfe-m11-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-cost"
      ]
    },
    {
      "id": "dbxfe-m11-l03-q2",
      "revision": "1",
      "prompt": "Why should released staff time not automatically be labeled cash savings?",
      "options": [
        {
          "id": "dbxfe-m11-l03-q2-b",
          "text": "Hours can never have business value.",
          "rationale": "Capacity and service improvements can still matter."
        },
        {
          "id": "dbxfe-m11-l03-q2-c",
          "text": "A larger software invoice proves more savings.",
          "rationale": "Cost and benefit are distinct quantities."
        },
        {
          "id": "dbxfe-m11-l03-q2-a",
          "text": "The organization may redeploy capacity without reducing spending.",
          "rationale": "Realization of financial benefit needs its own basis."
        }
      ],
      "correctOptionId": "dbxfe-m11-l03-q2-a",
      "conceptIds": [
        "dbxfe-m11-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-cost"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m11-l03-card1",
      "revision": "1",
      "prompt": "What is sensitivity analysis?",
      "answer": "Changing uncertain inputs to see how the conclusion changes.",
      "explanation": "It reveals which assumptions most need measurement.",
      "lessonId": "dbxfe-m11-l03",
      "sectionId": "dbxfe-m11-l03-understand",
      "conceptIds": [
        "dbxfe-m11-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-cost"
      ]
    },
    {
      "id": "dbxfe-m11-l03-card2",
      "revision": "1",
      "prompt": "What must a value calculation disclose?",
      "answer": "Period, inputs, formulas, one-time and recurring costs, exclusions, and realization assumptions.",
      "explanation": "Transparent arithmetic cannot compensate for hidden assumptions.",
      "lessonId": "dbxfe-m11-l03",
