  "questions": [
    {
      "id": "dbxfe-m01-l02-q1",
      "revision": "1",
      "prompt": "A delivery partner estimates effort before seeing the network restrictions. How should you describe the estimate?",
      "options": [
        {
          "id": "dbxfe-m01-l02-q1-b",
          "text": "Approved because a specialist supplied it.",
          "rationale": "Expertise does not remove missing inputs or customer acceptance."
        },
        {
          "id": "dbxfe-m01-l02-q1-c",
          "text": "Useless until every detail is known.",
          "rationale": "A conditional estimate can guide discovery if its limits are explicit."
        },
        {
          "id": "dbxfe-m01-l02-q1-a",
          "text": "Conditional on the unverified restrictions.",
          "rationale": "The assumption materially affects feasibility and effort."
        }
      ],
      "correctOptionId": "dbxfe-m01-l02-q1-a",
      "conceptIds": [
        "dbxfe-m01-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m01-l02-q2",
      "revision": "1",
      "prompt": "Which handoff is most useful?",
      "options": [
        {
          "id": "dbxfe-m01-l02-q2-c",
          "text": "A deadline assigned without asking the owner.",
          "rationale": "Unacknowledged ownership is not a reliable plan."
        },
        {
          "id": "dbxfe-m01-l02-q2-a",
          "text": "A bounded question, known facts, gaps, proposed owner, and response needed.",
          "rationale": "It gives the next person enough context to act and acknowledge ownership."
        },
        {
          "id": "dbxfe-m01-l02-q2-b",
          "text": "A transcript with no requested action.",
          "rationale": "The task and decision may be buried."
        }
      ],
      "correctOptionId": "dbxfe-m01-l02-q2-a",
      "conceptIds": [
        "dbxfe-m01-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m01-l02-card1",
      "revision": "1",
      "prompt": "What belongs in a responsibility handoff?",
      "answer": "The decision, question, known facts, gaps, proposed owner, acceptance, and next date.",
      "explanation": "The receiver should know both the task and why it matters.",
      "lessonId": "dbxfe-m01-l02",
      "sectionId": "dbxfe-m01-l02-understand",
      "conceptIds": [
        "dbxfe-m01-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m01-l02-card2",
      "revision": "1",
      "prompt": "Why distinguish a contributor from an acceptor?",
      "answer": "A contributor supplies work; the acceptor determines whether it meets the need.",
      "explanation": "A technically detailed response may still miss the customer decision.",
      "lessonId": "dbxfe-m01-l02",
      "sectionId": "dbxfe-m01-l02-understand",
      "conceptIds": [
        "dbxfe-m01-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m01-l02-card3",
      "revision": "1",
      "prompt": "How should an unconfirmed task assignment be labeled?",
      "answer": "Proposed owner, pending confirmation.",
      "explanation": "This avoids silently converting coordination into a false commitment.",
      "lessonId": "dbxfe-m01-l02",
      "sectionId": "dbxfe-m01-l02-understand",
      "conceptIds": [
