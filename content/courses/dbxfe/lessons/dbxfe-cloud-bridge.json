  "questions": [
    {
      "id": "dbxfe-cloud-bridge-foundation-q1",
      "revision": "1",
      "prompt": "A client fails DNS resolution before connecting. Which statement is supported?",
      "options": [
        {
          "id": "dbxfe-cloud-bridge-foundation-q1-a",
          "text": "The name-resolution step failed; object permission has not yet been exercised.",
          "rationale": "No service request reached authorization in the observed trace."
        },
        {
          "id": "dbxfe-cloud-bridge-foundation-q1-b",
          "text": "The object has denied SELECT.",
          "rationale": "A DNS failure says nothing about a later table privilege check."
        },
        {
          "id": "dbxfe-cloud-bridge-foundation-q1-c",
          "text": "The stored data has been deleted.",
          "rationale": "A naming failure is not evidence of object deletion."
        }
      ],
      "correctOptionId": "dbxfe-cloud-bridge-foundation-q1-a",
      "conceptIds": [
        "dbxfe-cloud-bridge-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-cloud",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-cloud-bridge-foundation-q2",
      "revision": "1",
      "prompt": "Why test with the scheduled job identity?",
      "options": [
        {
          "id": "dbxfe-cloud-bridge-foundation-q2-c",
          "text": "Identity only matters after data has been returned.",
          "rationale": "Authorization applies before the requested data access is allowed."
        },
        {
          "id": "dbxfe-cloud-bridge-foundation-q2-a",
          "text": "Its effective permissions can differ from the author’s interactive identity.",
          "rationale": "Execution context is part of the access claim."
        },
        {
          "id": "dbxfe-cloud-bridge-foundation-q2-b",
          "text": "An admin query automatically delegates its rights to every job.",
          "rationale": "An interactive result does not grant another principal access."
        }
      ],
      "correctOptionId": "dbxfe-cloud-bridge-foundation-q2-a",
      "conceptIds": [
        "dbxfe-cloud-bridge-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-cloud",
        "dbxfe-fiction"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-cloud-bridge-foundation-card1",
      "revision": "1",
      "prompt": "What is the difference between a route and an access grant?",
      "answer": "A route provides a network path; an access grant permits an action on a resource.",
      "explanation": "A path can exist while authorization denies the request.",
      "lessonId": "dbxfe-cloud-bridge",
