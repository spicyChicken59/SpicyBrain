      "id": "dbxfe-cloud-bridge-foundation-card2",
      "revision": "1",
      "prompt": "What does successful DNS resolution establish?",
      "answer": "The requested name was resolved to connection information.",
      "explanation": "It does not prove service reachability or object permission.",
