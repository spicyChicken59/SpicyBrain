  "questions": [
    {
      "id": "dbxfe-m12-l03-q1",
      "revision": "1",
      "prompt": "Which inconsistency should be fixed before presenting the engagement?",
      "options": [
        {
          "id": "dbxfe-m12-l03-q1-b",
          "text": "The same assumptions appear in multiple artifacts.",
          "rationale": "Repeating a consistent assumption can help traceability."
        },
        {
          "id": "dbxfe-m12-l03-q1-c",
          "text": "The model response acknowledges uncertainty.",
          "rationale": "Visible uncertainty is necessary when evidence is missing."
        },
        {
          "id": "dbxfe-m12-l03-q1-a",
          "text": "The demo uses inspection incidence while the pilot measures unit defect rate.",
          "rationale": "The artifacts would be testing and explaining different quantities."
        }
      ],
      "correctOptionId": "dbxfe-m12-l03-q1-a",
      "conceptIds": [
        "dbxfe-m12-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m12-l03-q2",
      "revision": "1",
      "prompt": "What does a capstone self-assessment establish?",
      "options": [
        {
          "id": "dbxfe-m12-l03-q2-c",
          "text": "That unexecuted cloud tests passed.",
          "rationale": "Reflection cannot create execution evidence."
        },
        {
          "id": "dbxfe-m12-l03-q2-a",
          "text": "The learner\u2019s reflection against an educational rubric.",
          "rationale": "It is useful feedback but not independent or employer validation."
        },
        {
          "id": "dbxfe-m12-l03-q2-b",
          "text": "An official credential or readiness score.",
          "rationale": "The course has no authority to confer those."
        }
      ],
      "correctOptionId": "dbxfe-m12-l03-q2-a",
      "conceptIds": [
        "dbxfe-m12-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m12-l03-card1",
      "revision": "1",
      "prompt": "What is engagement synthesis?",
      "answer": "Keeping the decision, definitions, assumptions, and evidence consistent across discovery, design, demo, test, value, and handoff.",
      "explanation": "The connections matter as much as individual artifacts.",
      "lessonId": "dbxfe-m12-l03",
      "sectionId": "dbxfe-m12-l03-understand",
      "conceptIds": [
        "dbxfe-m12-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m12-l03-card2",
      "revision": "1",
      "prompt": "What should a capstone recommendation expose?",
      "answer": "The evidence supporting it, credible alternatives, and unresolved conditions.",
      "explanation": "A defensible recommendation need not claim certainty.",
      "lessonId": "dbxfe-m12-l03",
      "sectionId": "dbxfe-m12-l03-understand",
      "conceptIds": [
        "dbxfe-m12-l03-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m12-l03-card3",
      "revision": "1",
      "prompt": "What does completing a scenario or lesson mean here?",
      "answer": "An explicit study action or self-assessment, separate from objective attempts and review history.",
      "explanation": "It does not establish certified mastery or employer readiness.",
