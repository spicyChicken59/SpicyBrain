  "cards": [
    {
      "id": "dbxfe-m06-l01-card1",
      "revision": "1",
      "prompt": "What does Unity Catalog organize and govern?",
      "answer": "Data and AI assets, with key objects addressed through catalog.schema.object.",
      "explanation": "Naming, object privileges, and operational responsibility remain distinct.",
      "lessonId": "dbxfe-m06-l01",
      "sectionId": "dbxfe-m06-l01-understand",
      "conceptIds": [
        "dbxfe-m06-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-unity",
        "dbxfe-fact-architecture"
      ]
    },
    {
      "id": "dbxfe-m06-l01-card2",
      "revision": "1",
      "prompt": "Why distinguish technical owner from metric owner?",
      "answer": "The technical owner manages the object; the metric owner accepts its business meaning.",
      "explanation": "One person may hold both roles, but the decisions are different.",
      "lessonId": "dbxfe-m06-l01",
      "sectionId": "dbxfe-m06-l01-understand",
      "conceptIds": [
        "dbxfe-m06-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-unity",
        "dbxfe-fact-architecture"
      ]
    },
    {
      "id": "dbxfe-m06-l01-card3",
      "revision": "1",
      "prompt": "What should accompany an external-table governance review?",
      "answer": "Registration, storage/credential configuration, object privileges, and alternate direct-access paths.",
      "explanation": "A catalog entry is not proof that every possible path is controlled.",
      "lessonId": "dbxfe-m06-l01",
      "sectionId": "dbxfe-m06-l01-understand",
      "conceptIds": [
        "dbxfe-m06-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-unity",
        "dbxfe-fact-architecture"
      ]
    },
    {
      "id": "dbxfe-m06-l01-foundation-card1",
      "revision": "1",
      "prompt": "Which three basic privileges support a table read?",
      "answer": "SELECT on the table, USE SCHEMA on its parent, and USE CATALOG on its parent catalog.",
      "explanation": "Other execution, binding and policy requirements still apply.",
      "lessonId": "dbxfe-m06-l01",
      "sectionId": "dbxfe-m06-l01-foundation-mechanism",
      "conceptIds": [
        "dbxfe-m06-l01-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-unity",
        "dbxfe-fact-privileges",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m06-l01-foundation-card2",
      "revision": "1",
      "prompt": "What does testing a denied action add to a consumer-access check?",
      "answer": "It checks that the intended reader still cannot access a named out-of-scope object.",
      "explanation": "A successful allowed query alone does not establish that the access boundary is narrow.",
      "lessonId": "dbxfe-m06-l01",
      "sectionId": "dbxfe-m06-l01-foundation-mechanism",
      "conceptIds": [
        "dbxfe-m06-l01-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-unity",
        "dbxfe-fact-privileges",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m06-l01-foundation-card3",
      "revision": "1",
      "prompt": "Why distinguish metastore and workspace?",
      "answer": "The metastore is a governance container; the workspace is an execution/collaboration environment.",
      "explanation": "A workspace’s use of a metastore does not merge their responsibilities.",
