  "questions": [
    {
      "id": "dbxfe-m06-l01-q1",
      "revision": "1",
      "prompt": "What does a three-part object name establish by itself?",
      "options": [
        {
          "id": "dbxfe-m06-l01-q1-c",
          "text": "That its business metric is approved.",
          "rationale": "A name does not establish semantic acceptance."
        },
        {
          "id": "dbxfe-m06-l01-q1-a",
          "text": "Where the object is addressed, not permission to use it.",
          "rationale": "Naming and authorization are separate responsibilities."
        },
        {
          "id": "dbxfe-m06-l01-q1-b",
          "text": "That every user may query it.",
          "rationale": "Access still depends on privileges and execution context."
        }
      ],
      "correctOptionId": "dbxfe-m06-l01-q1-a",
      "conceptIds": [
        "dbxfe-m06-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-unity",
        "dbxfe-fact-architecture"
      ]
    },
    {
      "id": "dbxfe-m06-l01-q2",
      "revision": "1",
      "prompt": "Which statement about an external table is more accurate?",
      "options": [
        {
          "id": "dbxfe-m06-l01-q2-a",
          "text": "It can be governed while storage lifecycle responsibility remains external.",
          "rationale": "External describes a responsibility boundary, not an absence of governance."
        },
        {
          "id": "dbxfe-m06-l01-q2-b",
          "text": "It is always outside all governance.",
          "rationale": "That confuses external storage lifecycle with object governance."
        },
        {
          "id": "dbxfe-m06-l01-q2-c",
          "text": "No one needs to check direct storage access.",
          "rationale": "Alternate access paths can matter to the security design."
        }
      ],
      "correctOptionId": "dbxfe-m06-l01-q2-a",
      "conceptIds": [
        "dbxfe-m06-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-unity",
        "dbxfe-fact-architecture"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m06-l01-card1",
      "revision": "1",
      "prompt": "What does Unity Catalog organize and govern?",
      "answer": "Data and AI assets, with key objects addressed through catalog.schema.object.",
      "explanation": "Naming, object privileges, and operational responsibility remain distinct.",
      "lessonId": "dbxfe-m06-l01",
      "sectionId": "dbxfe-m06-l01-understand",
      "conceptIds": [
        "dbxfe-m06-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-unity",
        "dbxfe-fact-architecture"
      ]
    },
    {
      "id": "dbxfe-m06-l01-card2",
      "revision": "1",
      "prompt": "Why distinguish technical owner from metric owner?",
      "answer": "The technical owner manages the object; the metric owner accepts its business meaning.",
      "explanation": "One person may hold both roles, but the decisions are different.",
      "lessonId": "dbxfe-m06-l01",
      "sectionId": "dbxfe-m06-l01-understand",
      "conceptIds": [
        "dbxfe-m06-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-unity",
        "dbxfe-fact-architecture"
      ]
    },
    {
      "id": "dbxfe-m06-l01-card3",
      "revision": "1",
      "prompt": "What should accompany an external-table governance review?",
      "answer": "Registration, storage/credential configuration, object privileges, and alternate direct-access paths.",
      "explanation": "A catalog entry is not proof that every possible path is controlled.",
      "lessonId": "dbxfe-m06-l01",
