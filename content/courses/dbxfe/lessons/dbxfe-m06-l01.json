  "questions": [
    {
      "id": "dbxfe-m06-l01-q1",
      "revision": "1",
      "prompt": "What does a three-part object name establish by itself?",
      "options": [
        {
          "id": "dbxfe-m06-l01-q1-c",
          "text": "That its business metric is approved.",
          "rationale": "A name does not establish semantic acceptance."
        },
        {
          "id": "dbxfe-m06-l01-q1-a",
          "text": "Where the object is addressed, not permission to use it.",
          "rationale": "Naming and authorization are separate responsibilities."
        },
        {
          "id": "dbxfe-m06-l01-q1-b",
          "text": "That every user may query it.",
          "rationale": "Access still depends on privileges and execution context."
        }
      ],
      "correctOptionId": "dbxfe-m06-l01-q1-a",
      "conceptIds": [
        "dbxfe-m06-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-unity",
        "dbxfe-fact-architecture"
      ]
    },
    {
      "id": "dbxfe-m06-l01-q2",
      "revision": "1",
      "prompt": "Which statement about an external table is more accurate?",
      "options": [
        {
          "id": "dbxfe-m06-l01-q2-a",
          "text": "It can be governed while storage lifecycle responsibility remains external.",
          "rationale": "External describes a responsibility boundary, not an absence of governance."
        },
        {
          "id": "dbxfe-m06-l01-q2-b",
          "text": "It is always outside all governance.",
          "rationale": "That confuses external storage lifecycle with object governance."
        },
        {
          "id": "dbxfe-m06-l01-q2-c",
          "text": "No one needs to check direct storage access.",
          "rationale": "Alternate access paths can matter to the security design."
        }
      ],
      "correctOptionId": "dbxfe-m06-l01-q2-a",
      "conceptIds": [
        "dbxfe-m06-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-unity",
        "dbxfe-fact-architecture"
      ]
    },
    {
      "id": "dbxfe-m06-l01-foundation-q1",
      "revision": "1",
      "prompt": "Ben has SELECT on the table and USE CATALOG, but lacks USE SCHEMA. Under the stated assumptions, what is missing?",
      "options": [
        {
          "id": "dbxfe-m06-l01-foundation-q1-a",
          "text": "USE SCHEMA on the table’s parent schema.",
          "rationale": "SELECT does not replace required parent usage."
        },
        {
          "id": "dbxfe-m06-l01-foundation-q1-b",
          "text": "SELECT on every table in the catalog.",
          "rationale": "That expands scope and does not follow the stated access need."
        },
        {
          "id": "dbxfe-m06-l01-foundation-q1-c",
          "text": "A faster compute instance.",
          "rationale": "Capacity does not supply a missing authorization grant."
        }
      ],
      "correctOptionId": "dbxfe-m06-l01-foundation-q1-a",
      "conceptIds": [
        "dbxfe-m06-l01-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-unity",
        "dbxfe-fact-privileges",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m06-l01-foundation-q2",
      "revision": "1",
      "prompt": "Why is querying as an administrator insufficient to verify Ben’s read access?",
      "options": [
        {
          "id": "dbxfe-m06-l01-foundation-q2-c",
          "text": "Table names change automatically for each principal.",
          "rationale": "The relevant difference is effective access, not automatic renaming."
        },
        {
          "id": "dbxfe-m06-l01-foundation-q2-a",
          "text": "The administrator and Ben can have different effective privileges.",
          "rationale": "The test must exercise the intended consumer identity and context."
        },
        {
          "id": "dbxfe-m06-l01-foundation-q2-b",
          "text": "Administrators cannot read governed data.",
          "rationale": "They may have access; the problem is that their result is not Ben’s result."
        }
      ],
      "correctOptionId": "dbxfe-m06-l01-foundation-q2-a",
      "conceptIds": [
        "dbxfe-m06-l01-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-fact-unity",
        "dbxfe-fact-privileges",
        "dbxfe-fiction"
      ]
    }
