  "questions": [
    {
      "id": "dbxfe-dataframes-foundation-q1",
      "revision": "1",
      "prompt": "What does F.col(\"inspected_units\") represent?",
      "options": [
        {
          "id": "dbxfe-dataframes-foundation-q1-a",
          "text": "A Spark column expression used to build a query plan.",
          "rationale": "It is evaluated over rows by Spark rather than being one local count."
        },
        {
          "id": "dbxfe-dataframes-foundation-q1-b",
          "text": "The Python integer in the first row.",
          "rationale": "A Column is not a selected scalar value."
        },
        {
          "id": "dbxfe-dataframes-foundation-q1-c",
          "text": "A guarantee that the field contains no nulls.",
          "rationale": "Nullability and validation require separate checks."
        }
      ],
      "correctOptionId": "dbxfe-dataframes-foundation-q1-a",
      "conceptIds": [
        "dbxfe-dataframes-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-dataframes-foundation-q2",
      "revision": "1",
      "prompt": "Why does the changed 0/0 row pass the quantity rule but need care in the rate?",
      "options": [
        {
          "id": "dbxfe-dataframes-foundation-q2-c",
          "text": "Casting to double makes division by zero a trustworthy percentage.",
          "rationale": "A type conversion does not supply a meaningful denominator."
        },
        {
          "id": "dbxfe-dataframes-foundation-q2-a",
          "text": "Nonnegative quantities satisfy the row rule; division by zero has no defined unit rate.",
          "rationale": "Validation and metric-denominator policy are different decisions."
        },
        {
          "id": "dbxfe-dataframes-foundation-q2-b",
          "text": "A zero count must always be discarded as missing.",
          "rationale": "Zero and missing are distinct."
        }
      ],
      "correctOptionId": "dbxfe-dataframes-foundation-q2-a",
      "conceptIds": [
        "dbxfe-dataframes-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    }
  ],
