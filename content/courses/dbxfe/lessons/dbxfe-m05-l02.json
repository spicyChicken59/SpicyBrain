  "questions": [
    {
      "id": "dbxfe-m05-l02-q1",
      "revision": "1",
      "prompt": "Run A spends 30 seconds queued and 5 executing. Which evidence deserves attention first?",
      "options": [
        {
          "id": "dbxfe-m05-l02-q1-c",
          "text": "The color of the result chart.",
          "rationale": "The table does not implicate presentation styling."
        },
        {
          "id": "dbxfe-m05-l02-q1-a",
          "text": "Peak concurrency and waiting conditions.",
          "rationale": "Queueing dominates the measured path, though other portions still matter."
        },
        {
          "id": "dbxfe-m05-l02-q1-b",
          "text": "Only the number of chart categories.",
          "rationale": "The measurements isolate most of the delay before query execution; chart complexity is not the dominant observed cause."
        }
      ],
      "correctOptionId": "dbxfe-m05-l02-q1-a",
      "conceptIds": [
        "dbxfe-m05-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-query-profile"
      ]
    },
    {
      "id": "dbxfe-m05-l02-q2",
      "revision": "1",
      "prompt": "Why is a cached run a poor direct comparison with a cold execution?",
      "options": [
        {
          "id": "dbxfe-m05-l02-q2-a",
          "text": "Different cache conditions can explain the timing difference.",
          "rationale": "The experiment needs comparable conditions to support a causal claim."
        },
        {
          "id": "dbxfe-m05-l02-q2-b",
          "text": "Cached results are always incorrect.",
          "rationale": "Caching does not by itself imply wrong results."
        },
        {
          "id": "dbxfe-m05-l02-q2-c",
          "text": "A query profile always includes queueing, browser rendering, and the user\u2019s full elapsed wait.",
          "rationale": "Execution evidence is only part of the end-to-end measurement; the compared cache conditions still matter."
        }
      ],
      "correctOptionId": "dbxfe-m05-l02-q2-a",
      "conceptIds": [
        "dbxfe-m05-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-query-profile"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m05-l02-card1",
      "revision": "1",
      "prompt": "What does a performance diagnosis separate?",
      "answer": "Waiting, execution, data layout/query behavior, and result delivery or rendering.",
      "explanation": "A single elapsed number does not identify the cause.",
      "lessonId": "dbxfe-m05-l02",
      "sectionId": "dbxfe-m05-l02-understand",
      "conceptIds": [
        "dbxfe-m05-l02-concept"
      ],
      "claimIds": [
