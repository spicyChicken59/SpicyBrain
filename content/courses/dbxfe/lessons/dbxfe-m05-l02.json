      ]
    },
    {
      "id": "dbxfe-m05-l02-card3",
      "revision": "1",
      "prompt": "Why change one major variable at a time?",
      "answer": "It makes the observed difference easier to attribute to a specific intervention.",
      "explanation": "A fast result without an explanation is weak tuning evidence.",
