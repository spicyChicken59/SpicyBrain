        "dbxfe-fiction",
        "dbxfe-fact-query-profile"
      ]
    },
    {
      "id": "dbxfe-m05-l02-card2",
      "revision": "1",
      "prompt": "What can a query profile reveal?",
      "answer": "Execution operators and metrics that help identify expensive work or unexpected row growth.",
      "explanation": "Interpret it alongside the full user path and run conditions.",
      "lessonId": "dbxfe-m05-l02",
      "sectionId": "dbxfe-m05-l02-understand",
