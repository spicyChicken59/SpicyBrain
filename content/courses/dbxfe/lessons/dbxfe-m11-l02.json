  "questions": [
    {
      "id": "dbxfe-m11-l02-q1",
      "revision": "1",
      "prompt": "The team says it cannot operate another platform. What is the best first response?",
      "options": [
        {
          "id": "dbxfe-m11-l02-q1-c",
          "text": "Promise a partner will handle everything without agreement.",
          "rationale": "That invents another party\u2019s commitment."
        },
        {
          "id": "dbxfe-m11-l02-q1-a",
          "text": "Ask which responsibilities lack capacity and treat that as a design constraint.",
          "rationale": "The concern can materially change scope and architecture."
        },
        {
          "id": "dbxfe-m11-l02-q1-b",
          "text": "Recite more features.",
          "rationale": "Features do not establish operational ownership."
        }
      ],
      "correctOptionId": "dbxfe-m11-l02-q1-a",
      "conceptIds": [
        "dbxfe-m11-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m11-l02-q2",
      "revision": "1",
      "prompt": "A customer reports a previous failed migration. What should you do?",
      "options": [
        {
          "id": "dbxfe-m11-l02-q2-a",
          "text": "Understand the failure conditions and show how any new plan addresses them with evidence.",
          "rationale": "Past experience can reveal material requirements."
        },
        {
          "id": "dbxfe-m11-l02-q2-b",
          "text": "Dismiss it as user error without investigation.",
          "rationale": "That guesses at cause and ignores useful context."
        },
        {
          "id": "dbxfe-m11-l02-q2-c",
          "text": "Remove the concern from the meeting notes.",
          "rationale": "The risk should remain visible until resolved."
        }
      ],
      "correctOptionId": "dbxfe-m11-l02-q2-a",
      "conceptIds": [
        "dbxfe-m11-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m11-l02-card1",
      "revision": "1",
      "prompt": "What is objection diagnosis?",
      "answer": "Understanding the concrete risk or requirement behind a concern before proposing a response.",
      "explanation": "The best response may change the design.",
      "lessonId": "dbxfe-m11-l02",
      "sectionId": "dbxfe-m11-l02-understand",
      "conceptIds": [
        "dbxfe-m11-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m11-l02-card2",
      "revision": "1",
      "prompt": "Why avoid promising unconfirmed partner support?",
      "answer": "It converts a possible contribution into an unsupported commitment.",
      "explanation": "Confirm ownership, scope, and authority first.",
      "lessonId": "dbxfe-m11-l02",
      "sectionId": "dbxfe-m11-l02-understand",
      "conceptIds": [
        "dbxfe-m11-l02-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m11-l02-card3",
      "revision": "1",
      "prompt": "How can \u201cwe already have a warehouse\u201d improve discovery?",
      "answer": "It prompts a comparison of what the current system meets, what is missing, and what duplication a change creates.",
