  "questions": [
    {
      "id": "dbxfe-m12-l01-q1",
      "revision": "1",
      "prompt": "Which task usually deserves priority in the stated fictional situation?",
      "options": [
        {
          "id": "dbxfe-m12-l01-q1-c",
          "text": "Ignore all small tasks in favor of the largest build.",
          "rationale": "Task size is not a measure of decision impact."
        },
        {
          "id": "dbxfe-m12-l01-q1-a",
          "text": "Resolve the mandatory security requirement that may block the pilot.",
          "rationale": "It can change feasibility and the next decision."
        },
        {
          "id": "dbxfe-m12-l01-q1-b",
          "text": "Add decorative slides before any requirements are agreed.",
          "rationale": "That does not remove the blocking uncertainty."
        }
      ],
      "correctOptionId": "dbxfe-m12-l01-q1-a",
      "conceptIds": [
        "dbxfe-m12-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m12-l01-q2",
      "revision": "1",
      "prompt": "Which next action is concrete?",
      "options": [
        {
          "id": "dbxfe-m12-l01-q2-a",
          "text": "Security lead confirms classification and permitted path before charter finalization.",
          "rationale": "It states owner, output, and dependency."
        },
        {
          "id": "dbxfe-m12-l01-q2-b",
          "text": "Follow up sometime.",
          "rationale": "The output and timing are unspecified."
        },
        {
          "id": "dbxfe-m12-l01-q2-c",
          "text": "Everyone should make progress.",
          "rationale": "There is no accountable owner or defined result."
        }
      ],
      "correctOptionId": "dbxfe-m12-l01-q2-a",
      "conceptIds": [
        "dbxfe-m12-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m12-l01-card1",
      "revision": "1",
      "prompt": "What is evidence priority?",
      "answer": "Choosing the action that most improves the next decision by reducing a material uncertainty or dependency.",
      "explanation": "It is not the same as choosing the most visible task.",
      "lessonId": "dbxfe-m12-l01",
      "sectionId": "dbxfe-m12-l01-understand",
      "conceptIds": [
        "dbxfe-m12-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-m12-l01-card2",
      "revision": "1",
      "prompt": "What makes a next action usable?",
      "answer": "A named owner, concrete output, and agreed date or condition.",
      "explanation": "Other people should be able to tell whether it happened.",
      "lessonId": "dbxfe-m12-l01",
      "sectionId": "dbxfe-m12-l01-understand",
      "conceptIds": [
