  "questions": [
    {
      "id": "dbxfe-m05-l01-q1",
      "revision": "1",
      "prompt": "One of two inspections found a defect, with 1 defective unit out of 20 inspected. Which statement is correct?",
      "options": [
        {
          "id": "dbxfe-m05-l01-q1-b",
          "text": "The two dashboards must always show the same percentage.",
          "rationale": "Different legitimate metrics can differ on the same input."
        },
        {
          "id": "dbxfe-m05-l01-q1-c",
          "text": "The faster query determines the correct definition.",
          "rationale": "Performance does not choose business meaning."
        },
        {
          "id": "dbxfe-m05-l01-q1-a",
          "text": "The unit defect rate is 5%; the inspection incidence is 50%.",
          "rationale": "The denominators represent different business questions."
        }
      ],
      "correctOptionId": "dbxfe-m05-l01-q1-a",
      "conceptIds": [
        "dbxfe-m05-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-sql"
      ]
    },
    {
      "id": "dbxfe-m05-l01-q2",
      "revision": "1",
      "prompt": "How should a zero inspected-unit denominator be handled in this proposed metric contract?",
      "options": [
        {
          "id": "dbxfe-m05-l01-q2-c",
          "text": "Divide by one to avoid an error.",
          "rationale": "That silently changes the metric."
        },
        {
          "id": "dbxfe-m05-l01-q2-a",
          "text": "Show the rate as undefined and explain the missing denominator.",
          "rationale": "Zero exposure does not establish a zero defect rate."
        },
        {
          "id": "dbxfe-m05-l01-q2-b",
          "text": "Always display 0% defects.",
          "rationale": "That implies an observed defect-free population."
        }
      ],
      "correctOptionId": "dbxfe-m05-l01-q2-a",
      "conceptIds": [
        "dbxfe-m05-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-sql"
      ]
    }
  ],
  "cards": [
    {
      "id": "dbxfe-m05-l01-card1",
      "revision": "1",
      "prompt": "What belongs in a metric contract?",
      "answer": "Meaning, grain, numerator, denominator, time basis, exclusions, correction policy, and owner.",
      "explanation": "The contract makes the result interpretable and testable.",
      "lessonId": "dbxfe-m05-l01",
      "sectionId": "dbxfe-m05-l01-understand",
      "conceptIds": [
        "dbxfe-m05-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-sql"
      ]
    },
    {
      "id": "dbxfe-m05-l01-card2",
      "revision": "1",
      "prompt": "Why show a data cut-off on a dashboard?",
      "answer": "It tells the user which accepted data supports the displayed number.",
      "explanation": "A fast page can still present stale or incomplete information.",
      "lessonId": "dbxfe-m05-l01",
      "sectionId": "dbxfe-m05-l01-understand",
      "conceptIds": [
        "dbxfe-m05-l01-concept"
      ],
      "claimIds": [
        "dbxfe-guidance",
        "dbxfe-fiction",
        "dbxfe-fact-sql"
      ]
    },
    {
      "id": "dbxfe-m05-l01-card3",
      "revision": "1",
      "prompt": "Does a SQL warehouse establish a shared metric definition?",
      "answer": "No. It executes SQL; people still need to agree the business calculation.",
      "explanation": "Performance and meaning are separate responsibilities: the warehouse can return a wrong number quickly if the business calculation was never agreed.",
      "lessonId": "dbxfe-m05-l01",
