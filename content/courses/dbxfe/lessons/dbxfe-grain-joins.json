    },
    {
      "id": "dbxfe-grain-joins-foundation-card2",
      "revision": "1",
      "prompt": "When does a left-semi join fit?",
      "answer": "When retaining left rows based on existence of a right-side match.",
      "explanation": "It avoids multiplying left rows by the number of matching right rows.",
