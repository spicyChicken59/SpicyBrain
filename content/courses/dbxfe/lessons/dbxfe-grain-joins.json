  "questions": [
    {
      "id": "dbxfe-grain-joins-foundation-q1",
      "revision": "1",
      "prompt": "One A inspection joins three matching tag rows. How many joined A rows result in the naive inner join?",
      "options": [
        {
          "id": "dbxfe-grain-joins-foundation-q1-a",
          "text": "Three.",
          "rationale": "The join returns each matching pair."
        },
        {
          "id": "dbxfe-grain-joins-foundation-q1-b",
          "text": "One, because the inspection_id text is identical.",
          "rationale": "A join does not automatically enforce the intended grain."
        },
        {
          "id": "dbxfe-grain-joins-foundation-q1-c",
          "text": "Six, because every join always squares the row count.",
          "rationale": "Count actual matches; there is one A row on the left and three on the right."
        }
      ],
      "correctOptionId": "dbxfe-grain-joins-foundation-q1-a",
      "conceptIds": [
        "dbxfe-grain-joins-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    },
    {
      "id": "dbxfe-grain-joins-foundation-q2",
      "revision": "1",
      "prompt": "What can a tiny local formatted plan establish?",
      "options": [
        {
          "id": "dbxfe-grain-joins-foundation-q2-c",
          "text": "That the business grain is correct because Spark optimized the query.",
          "rationale": "An optimizer can efficiently execute a semantically wrong join."
        },
        {
          "id": "dbxfe-grain-joins-foundation-q2-a",
          "text": "Which operators the local engine planned under that configuration.",
          "rationale": "It is observed local plan evidence with a bounded scope."
        },
        {
          "id": "dbxfe-grain-joins-foundation-q2-b",
          "text": "That production data will have no skew.",
          "rationale": "The synthetic distribution says nothing about production key skew."
        }
      ],
      "correctOptionId": "dbxfe-grain-joins-foundation-q2-a",
      "conceptIds": [
        "dbxfe-grain-joins-foundation-concept"
      ],
      "claimIds": [
        "dbxfe-foundation-spark",
        "dbxfe-fiction"
      ]
    }
  ],
