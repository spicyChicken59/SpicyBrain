{
  "name": "spicybrain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "npm run prepare:content && vite --host 127.0.0.1",
    "prepare:content": "node --import tsx scripts/content.ts --build",
    "validate:content": "node --import tsx scripts/content.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run prepare:content && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:content-extension": "node --import tsx scripts/content-extension.ts",
    "report:sources": "node --import tsx scripts/sources.ts",
    "check": "npm run validate:content && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
